#!/usr/bin/env bash
set -euo pipefail

profile="dev"
role="workstation"
personal="false"
editor="zed"
container="auto"
target="auto"
gpu="auto"
remote_owner="auto"
repo="RobertoVillegas/dotfiles"
prompt_input="${DOTFILES_PROMPT_INPUT:-/dev/tty}"

usage() {
  cat <<'EOF'
Usage: bootstrap [options]

Run without options to open the interactive setup menu.

  --dev                  Install the development profile (default)
  --minimal              Install only the portable core
  --devbox               Configure a headless development host
  --role=workstation|devbox
  --personal             Add personal applications
  --editor=zed|vscode|both|none
  --target=auto|macos|linux|wsl
  --gpu=auto|nvidia|none
  --container=auto|orbstack|docker-desktop|docker-engine|none
  --remote-owner=auto|windows|linux
  --repo=OWNER/REPO      Override the chezmoi repository
  -h, --help             Show this help
EOF
}

read_choice() {
  local prompt="$1"
  local default_answer="$2"
  local answer
  while true; do
    printf '%s' "$prompt" >&2
    IFS= read -r answer <&3
    answer="${answer:-$default_answer}"
    case "$answer" in
      1 | 2 | 3 | 4)
        printf '%s' "$answer"
        return 0
        ;;
      *) printf 'Choose one of the listed numbers.\n' >&2 ;;
    esac
  done
}

read_yes_no() {
  local prompt="$1"
  local default_answer="$2"
  local answer
  while true; do
    printf '%s' "$prompt" >&2
    IFS= read -r answer <&3
    answer="${answer:-$default_answer}"
    case "$answer" in
      y | Y | yes | YES) return 0 ;;
      n | N | no | NO) return 1 ;;
      *) printf 'Answer y or n.\n' >&2 ;;
    esac
  done
}

interactive_setup() {
  local choice
  exec 3<"$prompt_input"

  cat <<'EOF'

Dotfiles setup

  1) Workstation  Development tools and macOS desktop apps
  2) Devbox      Headless development host
  3) Minimal     Shell and portable CLI essentials

EOF

  choice="$(read_choice 'Choose a setup [1]: ' "1")"
  case "$choice" in
    1)
      profile="dev"
      role="workstation"
      container="auto"
      cat <<'EOF'

Editor

  1) Zed
  2) VS Code
  3) Both
  4) None

EOF
      choice="$(read_choice 'Choose an editor [1]: ' "1")"
      case "$choice" in
        1) editor="zed" ;;
        2) editor="vscode" ;;
        3) editor="both" ;;
        4) editor="none" ;;
      esac
      if read_yes_no 'Install personal apps such as Spotify and Flow? [y/N]: ' "n"; then
        personal="true"
      fi
      ;;
    2)
      profile="dev"
      role="devbox"
      editor="none"
      container="auto"
      personal="false"
      ;;
    3)
      profile="minimal"
      role="workstation"
      editor="none"
      container="none"
      personal="false"
      ;;
  esac

  cat <<EOF

Selected configuration

  Profile:        $profile
  Role:           $role
  Editor:         $editor
  Containers:     $container
  Personal apps:  $personal

EOF

  if ! read_yes_no 'Apply this configuration? [Y/n]: ' "y"; then
    echo "Setup cancelled."
    exit 0
  fi
  exec 3<&-
}

if (($# == 0)); then
  if [[ -t 1 && ("$prompt_input" != "/dev/tty" || -r /dev/tty) ]]; then
    interactive_setup
  else
    echo "No interactive terminal detected; using workstation defaults." >&2
  fi
fi

while (($#)); do
  case "$1" in
    --dev) profile="dev" ;;
    --minimal) profile="minimal" ;;
    --devbox)
      profile="dev"
      role="devbox"
      personal="false"
      editor="none"
      ;;
    --role=*) role="${1#*=}" ;;
    --personal) personal="true" ;;
    --editor=*) editor="${1#*=}" ;;
    --target=*) target="${1#*=}" ;;
    --gpu=*) gpu="${1#*=}" ;;
    --container=*) container="${1#*=}" ;;
    --remote-owner=*) remote_owner="${1#*=}" ;;
    --repo=*) repo="${1#*=}" ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

case "$editor" in zed | vscode | both | none) ;; *)
  echo "Invalid editor: $editor" >&2
  exit 2
  ;;
esac
case "$role" in workstation | devbox) ;; *)
  echo "Invalid machine role: $role" >&2
  exit 2
  ;;
esac
case "$target" in auto | macos | linux | wsl) ;; *)
  echo "Invalid target: $target" >&2
  exit 2
  ;;
esac
case "$gpu" in auto | nvidia | none) ;; *)
  echo "Invalid GPU: $gpu" >&2
  exit 2
  ;;
esac
case "$container" in auto | orbstack | docker-desktop | docker-engine | none) ;; *)
  echo "Invalid container runtime: $container" >&2
  exit 2
  ;;
esac
case "$remote_owner" in auto | windows | linux) ;; *)
  echo "Invalid remote owner: $remote_owner" >&2
  exit 2
  ;;
esac

is_wsl=false
if [[ -n "${WSL_INTEROP:-}" ]] || { [[ -r /proc/sys/kernel/osrelease ]] && grep -qi microsoft /proc/sys/kernel/osrelease; }; then is_wsl=true; fi
if [[ "$target" == "auto" ]]; then
  if $is_wsl; then target="wsl"; elif [[ "$(uname -s)" == "Darwin" ]]; then target="macos"; else target="linux"; fi
fi
if [[ "$gpu" == "auto" ]]; then
  if [[ "$target" == "wsl" && -e /usr/lib/wsl/lib/libcuda.so ]]; then gpu="nvidia"; else gpu="none"; fi
fi
if [[ "$container" == "auto" ]]; then
  if [[ "$target" == "macos" ]]; then container="orbstack"; elif [[ "$target" == "wsl" ]]; then container="docker-desktop"; else container="docker-engine"; fi
fi
if [[ "$remote_owner" == "auto" ]]; then
  if [[ "$target" == "wsl" ]]; then remote_owner="windows"; else remote_owner="linux"; fi
fi
if [[ "$target" == "wsl" && "$container" == "orbstack" ]]; then
  echo "Invalid combination: target=wsl does not support container=orbstack" >&2
  exit 2
fi
if [[ "$target" == "macos" && "$gpu" == "nvidia" ]]; then
  echo "Invalid combination: target=macos does not support gpu=nvidia" >&2
  exit 2
fi
if [[ "$target" == "wsl" && "$container" == "docker-engine" ]]; then echo "Warning: Docker Engine inside WSL is an advanced, non-default route." >&2; fi

if [[ "$role" == "devbox" ]]; then
  profile="dev"
  personal="false"
  editor="none"
fi

export DOTFILES_PROFILE="$profile"
export DOTFILES_ROLE="$role"
export DOTFILES_PERSONAL="$personal"
export DOTFILES_EDITOR="$editor"
export DOTFILES_TARGET="$target"
export DOTFILES_GPU="$gpu"
export DOTFILES_CONTAINER="$container"
export DOTFILES_REMOTE_OWNER="$remote_owner"

if ! command -v chezmoi >/dev/null 2>&1; then
  bin_dir="$HOME/.local/bin"
  mkdir -p "$bin_dir"
  sh -c "$(curl -fsLS https://get.chezmoi.io)" -- -b "$bin_dir"
  export PATH="$bin_dir:$PATH"
fi

script_dir=""
if [[ -n "${BASH_SOURCE[0]:-}" && -f "${BASH_SOURCE[0]}" ]]; then
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi

if [[ -n "$script_dir" && -d "$script_dir/.git" ]]; then
  default_source="$(chezmoi source-path)"
  if [[ "$default_source" != "$script_dir" && ! -e "$default_source" && ! -L "$default_source" ]]; then
    mkdir -p "$(dirname "$default_source")"
    ln -s "$script_dir" "$default_source"
  fi
  chezmoi --source "$script_dir" init
  source_args=(--source "$script_dir")
else
  chezmoi_source="$(chezmoi source-path)"
  if git -C "$chezmoi_source" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$chezmoi_source" pull --ff-only
    chezmoi init
  else
    chezmoi init "$repo"
  fi
  source_args=()
fi

if [[ "$target" == "wsl" ]]; then
  chezmoi "${source_args[@]}" apply --exclude=scripts
  command -v wsl-provision >/dev/null 2>&1 || {
    echo "wsl-provision was not deployed" >&2
    exit 1
  }
  wsl-provision
fi
chezmoi "${source_args[@]}" apply

echo
echo "Dotfiles applied: profile=$profile role=$role target=$target gpu=$gpu container=$container remote-owner=$remote_owner editor=$editor personal=$personal"
echo "Restart the shell with: exec zsh -l"
