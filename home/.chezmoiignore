{{/* Executor API key, read by the Authorization header in ~/.pi/agent/mcp.json.
     See docs/pi-mcp.md. */}}
.config/executor/**
.pi/agent/models-store.json
.pi/agent/sessions
.claude/.credentials.json
.claude_*
.claude-*
