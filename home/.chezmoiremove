{{ if eq .profile "dev" }}
{{/* mise owns these; a second copy earlier in PATH decides silently and each
     machine drifts. Every one of these was found live: hermes symlinked node,
     npm and npx to its own Node 22; a standalone uv 0.8.17 predated mise; and
     python/python3 pointed at a uv-managed 3.14.0rc2 release candidate.
     Version-suffixed pythons (python3.11 and friends) are left alone -- those
     are uv's per-version installs and do not collide with mise's python. */}}
.local/bin/node
.local/bin/npm
.local/bin/npx
.local/bin/uv
.local/bin/uvx
.local/bin/bunx
.local/bin/python
.local/bin/python3
{{ end }}

{{/* The agent context moved to ~/.config/agents/AGENTS.md so workstations get
     it too; the four agent symlinks point there now. */}}
.config/devbox/AGENT_CONTEXT.md

{{/* grill-me was a one-line alias for grilling (dotagents), which covers it. */}}
.agents/skills/grill-me

{{/* Settings of Pi packages that were removed (pi-fabric,
     pi-antigravity-bridge), and the pstack agents pi-subagents ran; they are
     generated under ~/.pi/agent/pstack/agents now. */}}
.pi/agent/fabric.json
.pi/agent/antigravity-bridge
.pi/agent/agents/poteto-agent.md
.pi/agent/agents/comment-sicko.md
{{/* Renamed to HARNESSES.md when pstack gained Claude Code and T3. */}}
.pi/agent/pstack/PI.md
