#!/usr/bin/env bash
set -euo pipefail

export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.local/share/mise}"
export PATH="$MISE_DATA_DIR/shims:$HOME/.local/bin:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"

{{- if eq .profile "dev" }}

if ! command -v herdr >/dev/null 2>&1; then
  echo "Herdr is unavailable; cannot install Herdr plugins." >&2
  exit 1
fi

# plugin_id, owner/repo, tag, commit. The tag is only a label for humans: both
# the ref and the guard use the commit, because a tag can be moved and a manifest
# version cannot be trusted -- worktrunk still declares 0.1.0 at tag v0.5.0, so a
# version check would reinstall it on every run and never converge. Comparing
# manifest versions also let termscope sit on an unpinned commit while looking
# compliant. Re-resolve with `gh api repos/<repo>/tags` when bumping.
plugins=(
  "herdr-file-viewer	smarzban/herdr-file-viewer	v1.18.0	4c2add6d952e81abc9ba4bbb9ff90107a626098c"
  "termscope	iurysza/termscope	v1.1.0	2b2d9d3b4e587f5a3041e76e3e548a15929b7167"
  "worktrunk	devashish2203/herdr-worktrunk	v0.7.0	9cde723b7c6ea5d3f4de94760888de0e4090727b"
  "fullerzz.sesh	fullerzz/herdr-plugin-sesh	v0.15.0	884ef8bbdf186c7533206585d6aeede7a798176b"
  "mirror	nikok6/herdr-mirror	v0.4.3	195398c1275f9f3d18ddff70282149005a2bec01"
)

if ! installed="$(herdr plugin list --json 2>&1)"; then
  printf '%s\n' "$installed" >&2
  if grep -q 'protocol_mismatch' <<<"$installed"; then
    echo "warn: Herdr plugin refresh deferred until the running server is restarted" >&2
    exit 0
  fi
  exit 1
fi

for entry in "${plugins[@]}"; do
  IFS=$'\t' read -r plugin_id repo tag commit <<<"$entry"
  if jq -e --arg id "$plugin_id" --arg commit "$commit" \
    '.result.plugins[]? | select(.plugin_id == $id and .source.resolved_commit == $commit)' \
    >/dev/null <<<"$installed"; then
    continue
  fi
  echo "Installing $plugin_id $tag ($commit)..."
  herdr plugin install "$repo" --ref "$commit" --yes
done
{{- end }}
