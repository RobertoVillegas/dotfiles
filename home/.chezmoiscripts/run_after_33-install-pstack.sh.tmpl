#!/usr/bin/env bash
set -euo pipefail

{{- if eq .profile "dev" }}
# pstack for Pi: see ~/.pi/agent/pstack/agents.toml. Runs on every apply for
# the same reason as run_after_32: the source follows upstream, so the daily
# dotfiles-autoupdate is what brings it forward.

export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.local/share/mise}"
export PATH="$HOME/.agents/bin:$MISE_DATA_DIR/shims:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"

project="$HOME/.pi/agent/pstack"
skills_dir="$project/.agents/skills"
agents_dir="$HOME/.pi/agent/agents"
settings="$HOME/.pi/agent/settings.json"
stamp="$HOME/.local/state/dotfiles/pstack-installed"

for tool in dotagents jq curl; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "$tool is unavailable; pstack was not installed." >&2
    exit 0
  fi
done

# Same throttle as run_after_32: cursor/plugins is a busy monorepo, so fetch it
# only when the manifest or dotagents changed, or once the last install is over
# 20 hours old. DOTFILES_SKILLS_FORCE=1 installs regardless.
want="$(
  {
    cat "$project/agents.toml"
    dotagents --version
  } | shasum -a 256 | cut -d' ' -f1
)"
due=1
if [ -z "${DOTFILES_SKILLS_FORCE:-}" ] && [ -f "$stamp" ] &&
  [ "$(cat "$stamp")" = "$want" ] && [ -z "$(find "$stamp" -mmin +1200)" ]; then
  due=""
fi

# A failure leaves the previous install in place and must not abort the apply.
# The retry covers dotagents tripping over its own shallow clone.
if [ -n "$due" ]; then
  installed=""
  for attempt in 1 2 3; do
    if (cd "$project" && dotagents --project install); then
      installed=1
      break
    fi
    [ "$attempt" -lt 3 ] && sleep 2
  done
  if [ -n "$installed" ]; then
    mkdir -p "${stamp%/*}"
    printf '%s\n' "$want" >"$stamp"
  else
    echo "dotagents could not install pstack; the previous install was left as it was." >&2
  fi
fi

[ -f "$skills_dir/poteto-mode/SKILL.md" ] || exit 0

# Pi reads the directory through its `skills` setting, so no other agent sees it.
# The path resolves from ~/.pi/agent.
if [ -f "$settings" ] &&
  ! jq -e '(.skills // []) | index("pstack/.agents/skills")' "$settings" >/dev/null; then
  tmp="$(mktemp)"
  jq '.skills = ((.skills // []) + ["pstack/.agents/skills"])' "$settings" >"$tmp"
  mv "$tmp" "$settings"
fi

# poteto-mode spawns two subagents defined in pstack/agents/, which dotagents
# does not install. Build Pi agents from them at the commit dotagents resolved,
# so they move with the skills and stay behind the same release-age window.
commit="$(
  sed -n '/^\[skills.poteto-mode\]/,/^\[/s/^resolved_commit = "\(.*\)"/\1/p' \
    "$project/agents.lock" | head -n 1
)"
[ -n "$commit" ] || exit 0

mkdir -p "$agents_dir"
for spec in "poteto-agent:" "comment-sicko:read, grep, find, ls, bash"; do
  name="${spec%%:*}"
  tools="${spec#*:}"
  if ! upstream="$(curl -fsSL "https://raw.githubusercontent.com/cursor/plugins/$commit/pstack/agents/$name.md")"; then
    echo "Could not fetch the pstack $name agent; kept the previous one." >&2
    continue
  fi
  description="$(printf '%s\n' "$upstream" | sed -n 's/^description: //p' | head -n 1)"
  body="$(printf '%s\n' "$upstream" | awk 'f; /^---$/ { n++; if (n == 2) f = 1 }')"
  generated="$(
    printf -- '---\n'
    printf 'name: %s\n' "$name"
    printf 'description: %s\n' "$description"
    [ -n "$tools" ] && printf 'tools: %s\n' "$tools"
    printf 'model: pi-claude/claude-opus-5-5\n'
    printf 'thinking: xhigh\n'
    printf -- '---\n\n'
    printf '<!-- Generated by run_after_33-install-pstack from cursor/plugins@%s. Do not edit. -->\n\n' "$commit"
    printf 'pstack is installed for Pi at `%s`; `poteto-mode` is `%s/poteto-mode/SKILL.md`. Read `%s/PI.md` before anything else and use its Pi equivalents wherever the text below names Cursor.\n' \
      "$skills_dir" "$skills_dir" "$project"
    printf '%s\n' "$body"
  )"
  if [ "$(cat "$agents_dir/$name.md" 2>/dev/null)" != "$generated" ]; then
    printf '%s\n' "$generated" >"$agents_dir/$name.md"
  fi
done
{{- end }}
