#!/usr/bin/env bash
set -euo pipefail

# Re-run whenever the declarative tool inventory changes.
# mise config: {{ includeTemplate "dot_config/mise/config.toml.tmpl" . | sha256sum }}

if ! command -v mise >/dev/null 2>&1; then
  export PATH="/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:$PATH"
fi
command -v mise >/dev/null 2>&1 || {
  echo "mise is unavailable; install the Brewfile first." >&2
  exit 1
}

cd "$HOME"
# npm.shell_out requires npm to exist before mise installs npm-backed tools.
mise install node pnpm bun
mise install

export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.local/share/mise}"
export PATH="$MISE_DATA_DIR/shims:$PATH"

{{- if eq .profile "dev" }}
# Tracking the stable channel would leave each machine on whatever shipped the
# day it was set up, so the installer gets an explicit version instead.
claude_version="2.1.220"
current_claude=""
if command -v claude >/dev/null 2>&1; then
  # `claude --version` prints "<version> (Claude Code)".
  current_claude="$(claude --version 2>/dev/null | awk '{print $1}')"
fi
if [ "$current_claude" != "$claude_version" ]; then
  curl -fsSL https://claude.ai/install.sh | bash -s "$claude_version"
fi
{{- end }}
