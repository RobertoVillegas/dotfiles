#!/usr/bin/env bash
set -euo pipefail

# Re-run whenever the declarative tool inventory changes.
# mise config: {{ includeTemplate "dot_config/mise/config.toml.tmpl" . | sha256sum }}

if ! command -v mise >/dev/null 2>&1; then
  export PATH="/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:$PATH"
fi
command -v mise >/dev/null 2>&1 || {
  echo "mise is unavailable; install the Brewfile first." >&2
  exit 1
}

cd "$HOME"
# npm.shell_out requires npm to exist before mise installs npm-backed tools.
mise install node pnpm bun
mise install

export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.local/share/mise}"
export PATH="$MISE_DATA_DIR/shims:$PATH"

{{- if eq .profile "dev" }}
if ! command -v claude >/dev/null 2>&1; then
  curl -fsSL https://claude.ai/install.sh | bash
fi
{{- end }}
