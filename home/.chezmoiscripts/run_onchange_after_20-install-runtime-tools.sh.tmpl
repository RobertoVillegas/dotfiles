#!/usr/bin/env bash
set -euo pipefail

# Re-run whenever the declarative tool inventory changes.
# mise config: {{ includeTemplate "dot_config/mise/config.toml.tmpl" . | sha256sum }}

if ! command -v mise >/dev/null 2>&1; then
  export PATH="/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:$PATH"
fi
command -v mise >/dev/null 2>&1 || {
  echo "mise is unavailable; install the Brewfile first." >&2
  exit 1
}

cd "$HOME"
# mise blocks npm lifecycle scripts by default. Agent Browser's binary setup
# and QMD's node-llama-cpp backend setup are narrowly allowlisted per tool;
# do not set npm_config_ignore_scripts here or it overrides those allowlists.
# T3 also carries a per-tool legacy peer-resolution workaround for its pinned
# Effect beta graph.

# npm.shell_out requires npm to exist before mise installs npm-backed tools.
mise install node pnpm bun
mise install

export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.local/share/mise}"
export PATH="$MISE_DATA_DIR/shims:$PATH"

{{- if eq .profile "dev" }}
# A floor, not an equality: Claude Code ships its own auto-updater, so it walks
# forward on its own between applies. Reinstalling on any mismatch would drag it
# back down every night only for it to update itself again. Set DISABLE_AUTOUPDATER
# in ~/.claude/settings.json if this should become a real pin.
claude_version="2.1.236"
current_claude=""
if command -v claude >/dev/null 2>&1; then
  # `claude --version` prints "<version> (Claude Code)".
  current_claude="$(claude --version 2>/dev/null | awk '{print $1}')"
fi
if [ -z "$current_claude" ]; then
  curl -fsSL https://claude.ai/install.sh | bash -s "$claude_version"
elif [ "$current_claude" != "$claude_version" ] &&
  [ "$(printf '%s\n%s\n' "$claude_version" "$current_claude" | sort -V | head -1)" = "$current_claude" ]; then
  # Not the shell installer: once the build is already on disk it reports success
  # while leaving ~/.local/bin/claude pointed at the old version. `claude install
  # --force` is what actually repoints the launcher.
  claude install "$claude_version" --force
fi
{{- end }}
