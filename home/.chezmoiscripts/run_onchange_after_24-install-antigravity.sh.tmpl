#!/usr/bin/env bash
set -euo pipefail

{{- if eq .profile "dev" }}
export PATH="$HOME/.local/bin:$PATH"

# Unpinnable: the upstream installer only accepts --dir and fetches the current
# release. Existing installs update through the official CLI so the stream-json
# protocol used by the Pi bridge stays compatible across machines.
if command -v agy >/dev/null 2>&1; then
  agy update
else
  target_dir="$HOME/.local/bin"
  setup_home="$(mktemp -d)"
  trap 'rm -rf "$setup_home"' EXIT

  # The native setup appends PATH entries to shell profiles. chezmoi already
  # owns PATH, so isolate that setup work while installing the real binary.
  curl -fsSL https://antigravity.google/cli/install.sh |
    HOME="$setup_home" bash -s -- --dir "$target_dir"
fi
{{- end }}
