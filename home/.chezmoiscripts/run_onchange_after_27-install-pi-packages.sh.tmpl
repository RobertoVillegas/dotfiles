#!/usr/bin/env bash
set -euo pipefail

export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.local/share/mise}"
export PATH="$MISE_DATA_DIR/shims:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"

{{- if eq .profile "dev" }}

if ! command -v pi >/dev/null 2>&1; then
  echo "pi is unavailable; cannot install pi packages." >&2
  exit 1
fi

# Our own list, replacing the @robzolkos/lazypi public catalog: that catalog was
# a third party deciding what each machine gets, and it shipped 22 extensions we
# never chose. This array is the source of truth for workstations and devboxes.
#
# npm sources carry no version on purpose -- `pi install` accepts a ref only for
# git sources, and pi itself is pinned in dot_config/mise/config.toml.tmpl. Pin a
# git source as `git:host/owner/repo@<commit>` when one is added here.
#
# Credentials, sessions, memory and the ~/.pi/agent/agents drop-ins stay
# unmanaged: they are machine data, not configuration.
packages=(
  npm:pi-web-access
  npm:pi-mcp-adapter
  npm:pi-subagents
  npm:@narumitw/pi-goal
  npm:pi-fabric
  npm:pi-memory
  npm:@trevonistrevon/pi-loop
  npm:@vanillagreen/pi-claude-bridge
  npm:pi-cursor-sdk
  npm:@estebanforge/pi-antigravity-bridge
)

# Known predecessors are removed deliberately. Pi credentials, sessions and
# provider configuration remain untouched.
obsolete_packages=(
  npm:pi-claude-bridge
  npm:pi-cursor-oauth
  npm:@tian.zuo/pi-antigravity
)

settings="$HOME/.pi/agent/settings.json"

for src in "${obsolete_packages[@]}"; do
  if [ -f "$settings" ] &&
    jq -e --arg s "$src" '.packages[]? | select(. == $s)' "$settings" >/dev/null; then
    echo "Removing obsolete $src..."
    pi remove "$src"
  fi
done

for src in "${packages[@]}"; do
  if [ -f "$settings" ] &&
    jq -e --arg s "$src" '.packages[]? | select(. == $s)' "$settings" >/dev/null; then
    continue
  fi
  echo "Installing $src..."
  pi install "$src"
done

# `pi install` skips sources already in settings; refresh those explicitly.
pi update --extensions

# Ask before loading repository-local Pi extensions, prompts, and themes. Keep
# an explicit user choice, but do not leave fresh machines on Pi's implicit
# default where a future upstream change could silently broaden trust.
if [ -f "$settings" ] && [ "$(jq -r '.defaultProjectTrust // empty' "$settings")" = "" ]; then
  settings_tmp="$(mktemp)"
  jq '.defaultProjectTrust = "ask"' "$settings" >"$settings_tmp"
  chmod 600 "$settings_tmp"
  mv "$settings_tmp" "$settings"
fi

# Conservative defaults for the Antigravity bridge. The config remains
# machine-local and user-editable after creation; chezmoi never overwrites it.
antigravity_config="$HOME/.pi/agent/antigravity-bridge/config.json"
if [ ! -e "$antigravity_config" ]; then
  install -d -m 700 "$(dirname "$antigravity_config")"
  umask 077
  printf '%s\n' '{' \
    '  "askTool": "on",' \
    '  "bridgeTools": "mcp",' \
    '  "digest": "off",' \
    '  "systemPrompt": "on",' \
    '  "approvals": { "gateMode": "shadow", "mode": "ask" }' \
    '}' >"$antigravity_config"
fi
{{- end }}
