#!/usr/bin/env bash
set -euo pipefail

export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.local/share/mise}"
export PATH="$MISE_DATA_DIR/shims:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"

{{- if eq .profile "dev" }}

if ! command -v pi >/dev/null 2>&1; then
  echo "pi is unavailable; cannot install pi packages." >&2
  exit 1
fi

# This array is the source of truth for workstations and devboxes.
#
# Every source is pinned. An extension runs with the user's full permissions,
# and an unpinned source would install whatever its maintainer published last
# on the next apply, on every machine at once. Pi treats a versioned npm spec as
# pinned and `pi install` of a new version replaces the old entry, so bumping is
# an edit here; dotfiles-outdated reports newer releases. Pin a git source as
# `git:host/owner/repo@<commit>`. Same 24-hour cooldown as mise: do not bump to a
# release younger than a day (pi-fabric 0.104.0 is a deliberate exception,
# taken together with pi 1.0.0, which it requires).
#
# Credentials, sessions, memory and the ~/.pi/agent/agents drop-ins stay
# unmanaged: they are machine data, not configuration.
packages=(
  npm:pi-web-access@0.35.0
  npm:pi-subagents@0.74.0
  npm:@narumitw/pi-goal@0.54.8
  npm:pi-fabric@0.104.0
  npm:pi-memory@0.4.2
  npm:@trevonistrevon/pi-loop@0.7.15
  npm:@vanillagreen/pi-claude-bridge@4.0.8
  npm:pi-cursor-sdk@0.4.0
  npm:@estebanforge/pi-antigravity-bridge@1.7.8
  npm:pi-service-tier@0.4.0
)

# Known predecessors are removed deliberately. Pi credentials, sessions and
# provider configuration remain untouched.
#
# pi-mcp-adapter: Pi 0.99 ships MCP built in (~/.pi/agent/mcp.json, /mcp,
# `pi mcp add`). An extension that registers /mcp replaces the built-in support,
# so keeping the adapter would leave Pi ignoring its own mcp.json.
obsolete_packages=(
  npm:pi-mcp-adapter
  npm:pi-claude-bridge
  npm:pi-cursor-oauth
  npm:@tian.zuo/pi-antigravity
)

settings="$HOME/.pi/agent/settings.json"

# Pi identifies an npm package by name, so match a settings entry with or
# without its @version and remove it by the exact string settings holds.
installed_entry() {
  [ -f "$settings" ] || return 0
  jq -r --arg s "$1" \
    '.packages[]? | select(type == "string" and sub("@[^@/]*$"; "") == $s)' \
    "$settings" | head -1
}

for src in "${obsolete_packages[@]}"; do
  entry="$(installed_entry "$src")"
  if [ -n "$entry" ]; then
    echo "Removing obsolete $entry..."
    pi remove "$entry"
  fi
done

for src in "${packages[@]}"; do
  if [ -f "$settings" ] &&
    jq -e --arg s "$src" '.packages[]? | select(. == $s)' "$settings" >/dev/null; then
    continue
  fi
  echo "Installing $src..."
  pi install "$src"
done

# Pinned sources do not move here; this only reconciles each installation with
# its declared version, e.g. after ~/.pi/agent/npm was cleared.
pi update --extensions

# Ask before loading repository-local Pi extensions, prompts, and themes. Keep
# an explicit user choice, but do not leave fresh machines on Pi's implicit
# default where a future upstream change could silently broaden trust.
if [ -f "$settings" ] && [ "$(jq -r '.defaultProjectTrust // empty' "$settings")" = "" ]; then
  settings_tmp="$(mktemp)"
  jq '.defaultProjectTrust = "ask"' "$settings" >"$settings_tmp"
  chmod 600 "$settings_tmp"
  mv "$settings_tmp" "$settings"
fi

# Conservative defaults for the Antigravity bridge. The config remains
# machine-local and user-editable after creation; chezmoi never overwrites it.
# bridgeTools "mcp" still matches only pi-mcp-adapter tools (bridge 1.7.8), so
# with Pi's built-in MCP it bridges skills alone -- the narrow surface we want.
antigravity_config="$HOME/.pi/agent/antigravity-bridge/config.json"
if [ ! -e "$antigravity_config" ]; then
  install -d -m 700 "$(dirname "$antigravity_config")"
  umask 077
  printf '%s\n' '{' \
    '  "askTool": "on",' \
    '  "bridgeTools": "mcp",' \
    '  "digest": "off",' \
    '  "systemPrompt": "on",' \
    '  "approvals": { "gateMode": "shadow", "mode": "ask" }' \
    '}' >"$antigravity_config"
fi
{{- end }}
