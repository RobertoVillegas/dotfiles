#!/usr/bin/env bash
set -euo pipefail

{{ if eq .profile "dev" -}}
export VERSION="1.9.0"
# The installer skips the download when the pinned version is already on PATH,
# and chezmoi owns ~/.zshrc, so it must not append its own PATH line there.
export PATH="$HOME/.druk/bin:$PATH"
installer="$(mktemp)"
trap 'rm -f "$installer"' EXIT HUP INT TERM
curl -fsSL https://druk.letstri.dev/install -o "$installer"
bash "$installer" --no-modify-path
{{ else -}}
:
{{ end -}}
