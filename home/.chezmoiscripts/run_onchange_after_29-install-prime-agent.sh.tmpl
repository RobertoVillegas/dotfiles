#!/usr/bin/env bash
set -euo pipefail

{{ if eq .profile "dev" -}}
export PRIME_AGENT_VERSION="0.7.0"
export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.local/share/mise}"
export PATH="$MISE_DATA_DIR/shims:$PATH"

# prime-agent --version reports on stderr, so this has to merge the streams.
current=""
if command -v prime-agent >/dev/null 2>&1; then
  current="$(prime-agent --version 2>&1 | tr -d '[:space:]')"
fi

# Prime Agent is not published to the npm registry: the installer downloads a
# checksummed tarball and runs npm install -g on it, so mise cannot own it as a
# declarative "npm:" tool. Bumping the pin above is what re-runs this script.
if [ "$current" != "$PRIME_AGENT_VERSION" ]; then
  # Prepare the IPython runtime (uv, Python 3.11, ipykernel) during install
  # instead of prompting, since chezmoi runs this without a terminal.
  export PRIME_AGENT_BOOTSTRAP_KERNEL_ON_INSTALL=1
  installer="$(mktemp)"
  trap 'rm -f "$installer"' EXIT HUP INT TERM
  curl -fsSL https://app.primeintellect.ai/prime-agent/install.sh -o "$installer"
  sh "$installer"
fi
{{ else -}}
:
{{ end -}}
