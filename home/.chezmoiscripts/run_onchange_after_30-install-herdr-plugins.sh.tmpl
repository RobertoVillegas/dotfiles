#!/usr/bin/env bash
set -euo pipefail

export PATH="/home/linuxbrew/.linuxbrew/bin:$HOME/.local/bin:$PATH"

{{- if eq .profile "dev" }}

if ! command -v herdr >/dev/null 2>&1; then
  echo "Herdr is unavailable; cannot install Herdr plugins." >&2
  exit 1
fi

if ! herdr plugin list --json |
  jq -e '.result.plugins[]? | select(.plugin_id == "herdr-file-viewer")' >/dev/null; then
  echo "Installing herdr-file-viewer..."
  herdr plugin install smarzban/herdr-file-viewer --yes
fi

if ! herdr plugin list --json |
  jq -e '.result.plugins[]? | select(.plugin_id == "termscope")' >/dev/null; then
  echo "Installing termscope..."
  herdr plugin install iurysza/termscope --yes
fi

if ! herdr plugin list --json |
  jq -e '.result.plugins[]? | select(.plugin_id == "worktrunk")' >/dev/null; then
  echo "Installing herdr-worktrunk..."
  herdr plugin install devashish2203/herdr-worktrunk --yes
fi

if ! herdr plugin list --json |
  jq -e '.result.plugins[]? | select(.plugin_id == "fullerzz.sesh")' >/dev/null; then
  echo "Installing herdr-plugin-sesh..."
  herdr plugin install fullerzz/herdr-plugin-sesh --yes
fi
{{- end }}
