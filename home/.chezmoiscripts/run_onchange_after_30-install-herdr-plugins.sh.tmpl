#!/usr/bin/env bash
set -euo pipefail

export PATH="/home/linuxbrew/.linuxbrew/bin:$HOME/.local/bin:$PATH"

{{- if eq .profile "dev" }}

if ! command -v herdr >/dev/null 2>&1; then
  echo "Herdr is unavailable; cannot install Herdr plugins." >&2
  exit 1
fi

# plugin_id, owner/repo, version. Without --ref herdr takes the default branch,
# which froze each plugin at whatever it was on install day with no record of
# which commit that was. The manifest reports the tag without its leading "v".
plugins=(
  "herdr-file-viewer	smarzban/herdr-file-viewer	1.14.0"
  "termscope	iurysza/termscope	0.2.0"
  "worktrunk	devashish2203/herdr-worktrunk	0.1.0"
  "fullerzz.sesh	fullerzz/herdr-plugin-sesh	0.6.0"
)

installed="$(herdr plugin list --json)"

for entry in "${plugins[@]}"; do
  IFS=$'\t' read -r plugin_id repo version <<<"$entry"
  if jq -e --arg id "$plugin_id" --arg version "$version" \
    '.result.plugins[]? | select(.plugin_id == $id and .version == $version)' \
    >/dev/null <<<"$installed"; then
    continue
  fi
  echo "Installing $plugin_id v$version..."
  herdr plugin install "$repo" --ref "v$version" --yes
done
{{- end }}
