[tools]
# JavaScript runtimes and package managers.
node = "24.22.1"
pnpm = "12.15.0"
bun = "1.4.4"

{{- if eq .profile "dev" }}
# Language toolchains and their CLIs. just and uv used to sit in the Brewfile
# while mise installed them too, so each machine ran whichever copy its PATH hit
# first, at different versions. One owner each: mise takes anything tied to a
# language ecosystem, brew keeps the native system tools.
just = "1.59.0"
uv = "0.13.5"
ruff = "0.17.2"
python = "3.14.9"
{{- end }}

{{- if and (eq .profile "dev") (ne .gpu "none") }}
# Only where there is a GPU: the Rust toolchain is over a gigabyte and flatc is
# specific to the work that happens on that machine.
rust = "1.99.1"
flatc = "25.12.19"
{{- end }}

{{- if eq .profile "dev" }}
# Coding agents and their companion tools. Pinned rather than "latest": mise
# resolves "latest" when a machine first installs the tool, so two devboxes set
# up on different days silently end up on different versions. Bump these by
# hand when an upgrade is actually wanted.
# Codex and Pi are the exception and update themselves: see config.local.toml.
herdr = "0.9.5"
worktrunk = "0.81.0"
"npm:@fission-ai/openspec" = "1.14.3"
# Shared QMD executable; Pi and Hermes keep separate named collections.
# Third-party Agent Skills; the manifest is ~/.agents/agents.toml.
"npm:@sentry/dotagents" = "3.4.0"
"npm:@tobilu/qmd" = { version = "2.8.3", allow_builds = ["node-llama-cpp"] }
"npm:@vercel/before-and-after" = "0.0.4"
"npm:agent-browser" = { version = "0.39.2", allow_builds = ["agent-browser"] }
"npm:dev3000" = "0.0.182"
"npm:portless" = "0.15.9"
# Cloudflare's CLI for the whole API (DNS, zones); Wrangler has no DNS commands.
# Still in beta, so keep an exact pin and read the changelog before bumping.
"npm:cf" = "1.0.0-beta.20"
# Nightly on purpose: Orchestrator V2 (Pi provider, delegate_task) is not in a
# stable release yet. Keep it equal to the T3 Code nightly desktop app.
"npm:t3" = { version = "0.0.46-nightly.20261005.2667", npm_args = "--legacy-peer-deps" }
{{- end }}

[settings]
idiomatic_version_file_enable_tools = ["node"]
npm.shell_out = true
# A pin says which version; the lockfile says which exact bytes. It also stores
# the resolved download URLs, which keeps installs off the GitHub API.
lockfile = true
lockfile_platforms = ["macos-arm64", "linux-x64"]
# Every profile shares this one lockfile, but rust and flatc are installed only
# where there is a GPU. With pruning on, mise drops their entries on the other
# machines, chezmoi sees the lockfile changed under it, and the unattended
# apply aborts on its overwrite prompt.
lockfile_auto_prune = false
# Refuse versions published in the last 4 hours. A poisoned release is usually
# yanked within hours; 4 hours covers the fastest takedowns while letting dev
# tooling pick up a fresh release the same day, which 24 hours kept blocking.
# Spelled out rather than left to mise's default, which `mise settings get`
# reports unset.
minimum_release_age = "4h"
# First-party agent CLIs whose vendors already hold full access to this machine
# skip the window: T3's provider compatibility table moves with each release,
# and Claude Code and OpenCode update themselves outside mise anyway. Every
# other tool, including third-party extensions, keeps the quarantine.
minimum_release_age_excludes = [
  "npm:@openai/codex",
  "npm:@earendil-works/pi-coding-agent",
  "npm:t3",
]
