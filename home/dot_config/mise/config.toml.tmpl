[tools]
# JavaScript runtimes and package managers.
node = "24.18.1"
pnpm = "11.20.0"
bun = "1.3.14"

{{- if eq .profile "dev" }}
# Language toolchains and their CLIs. just and uv used to sit in the Brewfile
# while mise installed them too, so each machine ran whichever copy its PATH hit
# first, at different versions. One owner each: mise takes anything tied to a
# language ecosystem, brew keeps the native system tools.
just = "1.58.0"
uv = "0.12.2"
ruff = "0.16.1"
python = "3.14.7"
{{- end }}

{{- if and (eq .profile "dev") (ne .gpu "none") }}
# Only where there is a GPU: the Rust toolchain is over a gigabyte and flatc is
# specific to the work that happens on that machine.
rust = "1.97.1"
flatc = "25.12.19"
{{- end }}

{{- if eq .profile "dev" }}
# Coding agents and their companion tools. Pinned rather than "latest": mise
# resolves "latest" when a machine first installs the tool, so two devboxes set
# up on different days silently end up on different versions. Bump these by
# hand when an upgrade is actually wanted.
"npm:@earendil-works/pi-coding-agent" = "0.84.0"
"npm:@fission-ai/openspec" = "1.8.0"
"npm:@openai/codex" = "0.146.1"
"npm:@vercel/before-and-after" = "0.0.4"
"npm:agent-browser" = "0.33.2"
"npm:dev3000" = "0.0.178"
{{- end }}

[settings]
idiomatic_version_file_enable_tools = ["node"]
npm.shell_out = true
# A pin says which version; the lockfile says which exact bytes. It also stores
# the resolved download URLs, which keeps installs off the GitHub API.
lockfile = true
lockfile_platforms = ["macos-arm64", "linux-x64"]
# Refuse versions published in the last day. A poisoned release is usually
# yanked within hours, so a single day closes most of the window at a fraction
# of the staleness a week costs. The docs claim this is already the default but
# `mise settings get` reports it unset, so it is spelled out rather than assumed.
minimum_release_age = "24h"
