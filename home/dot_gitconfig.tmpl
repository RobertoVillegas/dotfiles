{{ if or (and .gitName .gitEmail) (eq .role "devbox") -}}
[user]
{{ if and .gitName .gitEmail -}}
	name = {{ .gitName }}
	email = {{ .gitEmail }}
{{ end -}}
{{ if eq .role "devbox" -}}
{{ if eq .target "wsl" -}}
	signingkey = ~/.ssh/devbox_gpu_github.pub
{{ else -}}
	signingkey = ~/.ssh/devbox_github.pub
{{ end -}}
{{ end -}}
{{ end -}}
{{ if eq .role "devbox" -}}
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
{{ end }}
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[init]
	defaultBranch = main
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[include]
	path = ~/.gitconfig.local
{{ if eq .profile "dev" -}}
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
{{ end -}}
