#!/bin/sh
set -u

# Reports which pinned tools have a newer upstream release. It changes nothing:
# bumping a pin is an edit in the dotfiles repo, which is the whole point of
# pinning. `mise outdated` cannot answer this, because an exact pin is by
# definition the latest version satisfying the request.

export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.local/share/mise}"
PATH="$MISE_DATA_DIR/shims:$HOME/.local/bin:$HOME/.druk/bin:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"
export PATH

behind=0
unknown=0
quarantined=0

# Same 7-day window the installers enforce. A version newer than this is not
# proposed: a poisoned release is usually yanked within hours, and the only way
# these machines would reach one is by bumping a pin during that window.
cooldown_cutoff="$(date -u -d '7 days ago' +%Y-%m-%d 2>/dev/null ||
	date -u -v-7d +%Y-%m-%d 2>/dev/null || echo '')"

strip_v() { printf '%s' "${1#v}"; }

# ISO-8601 dates compare correctly as plain strings once truncated to the day.
too_new() {
	[ -n "${1:-}" ] && [ -n "$cooldown_cutoff" ] && [ "${1%%T*}" \> "$cooldown_cutoff" ]
}

# Unauthenticated api.github.com allows 60 requests an hour, which this report
# can exhaust on its own. Prefer gh, which is authenticated and gets 5000.
if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
	use_gh=1
else
	use_gh=0
fi

github_json() {
	if [ "$use_gh" = 1 ]; then
		gh api "$1" 2>/dev/null
	else
		curl -fsSL "https://api.github.com/$1" 2>/dev/null
	fi
}

github_latest_release() {
	github_json "repos/$1/releases/latest" | jq -r '.tag_name // empty' 2>/dev/null
}

github_release_date() {
	github_json "repos/$1/releases/latest" | jq -r '.published_at // empty' 2>/dev/null
}

npm_version_date() {
	npm view "$1" "time.$2" 2>/dev/null | tr -d '\r'
}

github_latest_tag() {
	github_json "repos/$1/tags" | jq -r '.[0].name // empty' 2>/dev/null
}

# A tag carries no date of its own, so the quarantine has to read the commit it
# points at. Without this the tag-based tools bypass the window entirely.
github_tag_date() {
	tag_sha="$(github_json "repos/$1/tags" | jq -r '.[0].commit.sha // empty' 2>/dev/null)"
	[ -n "$tag_sha" ] || return 0
	github_json "repos/$1/commits/$tag_sha" |
		jq -r '.commit.committer.date // empty' 2>/dev/null
}

# name, current, latest, where the pin lives
report() {
	name="$1"
	current="$(strip_v "${2:-}")"
	latest="$(strip_v "${3:-}")"
	where="$4"

	if [ -z "$current" ] || [ -z "$latest" ]; then
		printf '  %-38s %-11s %-11s %s\n' "$name" "${current:-?}" "${latest:-?}" "no se pudo resolver"
		unknown=$((unknown + 1))
		return
	fi

	if [ "$current" = "$latest" ]; then
		printf '  %-38s %-11s %s\n' "$name" "$current" "al día"
		return
	fi

	# Claude Code auto-updates itself, so it can sit ahead of the pinned stable
	# release. That is not something to bump.
	if [ "$(printf '%s\n%s\n' "$current" "$latest" | sort -V | tail -1)" = "$current" ]; then
		printf '  %-38s %-11s %-11s %s\n' "$name" "$current" "$latest" "adelantado al pin"
		return
	fi

	if too_new "${5:-}"; then
		printf '  %-38s %-11s %-11s %s\n' "$name" "$current" "$latest" "en cuarentena, <7d"
		quarantined=$((quarantined + 1))
		return
	fi

	printf '  %-38s %-11s %-11s %s\n' "$name" "$current" "$latest" "$where"
	behind=$((behind + 1))
}

printf '\nPins de las dotfiles\n\n'
printf '  %-38s %-11s %-11s %s\n' "HERRAMIENTA" "ACTUAL" "LATEST" "DÓNDE SE EDITA"
printf '  %-38s %-11s %-11s %s\n' "-----------" "------" "------" "--------------"

# --- mise: runtimes y CLIs de npm -------------------------------------------
mise_config="dot_config/mise/config.toml.tmpl"
mise_config_file="${MISE_CONFIG_FILE:-$HOME/.config/mise/config.toml}"
if command -v mise >/dev/null 2>&1 && [ -f "$mise_config_file" ]; then
	# Read the declared [tools], not `mise ls --installed`: a machine can carry
	# tools installed by hand that the dotfiles never declared, and listing those
	# would point at a config file that says nothing about them.
	mise_tools="$(awk '
		/^[[:space:]]*#/ { next }
		/^\[tools\]/     { in_tools = 1; next }
		/^\[/            { in_tools = 0 }
		in_tools && /=/ {
			key = $0; sub(/[[:space:]]*=.*/, "", key); gsub(/["[:space:]]/, "", key)
			val = $0; sub(/^[^=]*=[[:space:]]*/, "", val); gsub(/["[:space:]]/, "", val)
			if (key != "" && val != "") print key, val
		}
	' "$mise_config_file")"
	# Here-doc, not a pipe: a piped `while` runs in a subshell and the counters
	# report() keeps would be discarded.
	while read -r tool pinned; do
		[ -n "$tool" ] || continue
		report "$tool" "$pinned" "$(mise latest "$tool" 2>/dev/null)" "$mise_config"
	done <<EOF
$mise_tools
EOF
else
	printf '  mise no está disponible\n'
fi

# --- instaladores con su propio script --------------------------------------
scripts=".chezmoiscripts"

if command -v claude >/dev/null 2>&1; then
	report "claude" \
		"$(claude --version 2>/dev/null | awk '{print $1}')" \
		"$(curl -fsSL https://downloads.claude.ai/claude-code-releases/stable 2>/dev/null)" \
		"$scripts/…20-install-runtime-tools"
fi

if command -v prime-agent >/dev/null 2>&1; then
	# prime-agent reporta la versión en stderr.
	report "prime-agent" \
		"$(prime-agent --version 2>&1 | tr -d '[:space:]')" \
		"$(curl -fsSL https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/stable 2>/dev/null)" \
		"$scripts/…29-install-prime-agent"
fi

if command -v ax >/dev/null 2>&1; then
	report "ax" "$(ax --version 2>/dev/null | head -1)" \
		"$(github_latest_release yusukebe/ax)" "$scripts/…25-install-ax" \
		"$(github_release_date yusukebe/ax)"
fi

if command -v druk >/dev/null 2>&1; then
	report "druk" "$(druk --version 2>/dev/null | head -1)" \
		"$(github_latest_release letstri/druk)" "$scripts/…28-install-druk" \
		"$(github_release_date letstri/druk)"
fi

# LazyPi corre por npx, así que no deja binario: el pin vive en el script.
lazypi_source="$(chezmoi source-path 2>/dev/null)/$scripts/run_onchange_after_27-install-lazypi.sh.tmpl"
if [ -f "$lazypi_source" ]; then
	lazypi_latest="$(npm view @robzolkos/lazypi version 2>/dev/null)"
	report "lazypi" \
		"$(sed -n 's/.*@robzolkos\/lazypi@\([0-9][0-9.]*\).*/\1/p' "$lazypi_source" | head -1)" \
		"$lazypi_latest" \
		"$scripts/…27-install-lazypi" \
		"$(npm_version_date @robzolkos/lazypi "$lazypi_latest")"
fi

# --- plugins de Herdr (pineados por --ref) ----------------------------------
if command -v herdr >/dev/null 2>&1; then
	plugins="herdr-file-viewer:smarzban/herdr-file-viewer
termscope:iurysza/termscope
worktrunk:devashish2203/herdr-worktrunk
fullerzz.sesh:fullerzz/herdr-plugin-sesh"
	installed_plugins="$(herdr plugin list --json 2>/dev/null)"
	while IFS=: read -r plugin_id repo; do
		[ -n "$plugin_id" ] || continue
		# Compare commits, not manifest versions: worktrunk declares 0.1.0 at tag
		# v0.5.0, so a version check would call it stale forever.
		have="$(printf '%s' "$installed_plugins" | jq -r --arg id "$plugin_id" \
			'.result.plugins[]? | select(.plugin_id == $id) | .source.resolved_commit' 2>/dev/null)"
		want_tag="$(github_latest_tag "$repo")"
		want="$(github_json "repos/$repo/tags" |
			jq -r --arg t "$want_tag" '.[] | select(.name == $t) | .commit.sha' 2>/dev/null)"
		name="herdr/$plugin_id"
		if [ -z "$have" ] || [ -z "$want" ]; then
			printf '  %-38s %-11s %-11s %s\n' "$name" "$(printf '%.9s' "$have")" \
				"${want_tag:-?}" "no se pudo resolver"
			unknown=$((unknown + 1))
		elif [ "$have" = "$want" ]; then
			printf '  %-38s %-11s %s\n' "$name" "$want_tag" "al día"
		elif too_new "$(github_tag_date "$repo")"; then
			printf '  %-38s %-11s %-11s %s\n' "$name" "$(printf '%.9s' "$have")" \
				"$want_tag" "en cuarentena, <7d"
			quarantined=$((quarantined + 1))
		else
			printf '  %-38s %-11s %-11s %s\n' "$name" "$(printf '%.9s' "$have")" \
				"$want_tag" "$scripts/…30-install-herdr-plugins"
			behind=$((behind + 1))
		fi
	done <<EOF
$plugins
EOF
fi

# --- sin pin posible ---------------------------------------------------------
if command -v agy >/dev/null 2>&1; then
	printf '\n  %-38s %-11s %s\n' "agy (Antigravity)" \
		"$(agy --version 2>/dev/null | head -1)" \
		"sin pin: su instalador no acepta versión"
fi

if command -v brew >/dev/null 2>&1; then
	casks="$(brew outdated --cask --quiet 2>/dev/null | wc -l | tr -d ' ')"
	printf '  %-38s %-11s %s\n' "casks de Homebrew" "$casks" \
		"rolling manual: brew upgrade --cask"
fi

printf '\n'
if [ "$behind" -eq 0 ]; then
	printf 'Todos los pins están al día.\n'
else
	printf '%d pin(s) con versión más nueva disponible.\n' "$behind"
fi
[ "$quarantined" -eq 0 ] || printf '%d en cuarentena por tener menos de 7 días publicados.\n' "$quarantined"
[ "$unknown" -eq 0 ] || printf '%d no se pudieron resolver (¿sin red o límite de la API de GitHub?).\n' "$unknown"
printf '\n'
