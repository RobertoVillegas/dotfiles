#!/usr/bin/env node
// executor-pipe — run Executor programs that carry secrets without the values
// entering the agent's context. Values are read from env files and spliced into
// the program; nothing from the response is printed unless marked public.
//
// Usage:
//   executor-pipe run <program.js> [--secrets <file.env>]... [--show NAME,...] [--show-errors]
//   executor-pipe resume <requestId> accept|decline|cancel [--secrets <file.env>]... [--show NAME,...] [--show-errors]
//   executor-pipe fp <file.env> <NAME>     local fingerprint of one value
//   executor-pipe selftest                 check the redaction, no network
//
// In <program.js>, __NAME__ becomes the JSON string of NAME from the secrets
// files. An unknown __NAME__ is an error, so a typo never sends a literal
// placeholder. Two helpers are defined for the program:
//   pub(value)  marks a returned value as public, so it is printed
//   fp(value)   { len, fp } of a value, already public (the sandbox has no crypto)
//
// Output is deny by default. Every string and number in the program's result
// and in an approval's input prints as <redacted:N> (N = length) unless the
// program wrapped it in pub(), or its object key or env name is in --show
// (--show KEY reveals everything under that key). Multi-line strings print one
// line per entry as NAME=<redacted:N> when the line is an UPPER_SNAKE_CASE
// name, "=" and a value; any other line, and any single-line string, is masked
// whole, so a base64 value with "=" padding never passes as a name. The
// identifier of a {name|key, value} pair, object keys, booleans and the
// envelope (status, request ID, tool, call outcomes) print as they are. Error
// messages and non-JSON replies are masked whole; --show-errors prints them
// with only the --secrets values masked.
//
// Connection: EXECUTOR_MCP_URL and EXECUTOR_MCP_AUTH, else the "executor"
// server in ~/.pi/agent/mcp.json (a header starting with "!" runs as a shell
// command, as Pi does).
import { execSync } from "node:child_process";
import { readFileSync } from "node:fs";
import { homedir } from "node:os";

const die = (msg) => {
	console.error(`executor-pipe: ${msg}`);
	process.exit(1);
};

// ---------------------------------------------------------------------------
// Secrets files

const readEnvFiles = (files) => {
	const values = {};
	for (const file of files) {
		for (const line of readFileSync(file, "utf8").split("\n")) {
			const m = /^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$/.exec(line);
			if (!m) continue;
			let v = m[2].trim();
			if (/^(['"]).*\1$/.test(v)) v = v.slice(1, -1);
			values[m[1]] = v;
		}
	}
	return values;
};

// ---------------------------------------------------------------------------
// Redaction: deny by default

const PUBLIC = "__executorPipePublic";
const PROGRAM_HELPERS = [
	`const pub = (v) => ({ ${PUBLIC}: v });`,
	`const fp = (v) => { let h = 0; for (const c of String(v)) h = (h * 31 + c.charCodeAt(0)) >>> 0; return pub({ len: String(v).length, fp: h }); };`,
].join("\n");
const fp = (v) => {
	let h = 0;
	for (const c of String(v)) h = (h * 31 + c.charCodeAt(0)) >>> 0;
	return { len: String(v).length, fp: h };
};

const hidden = (v) => `<redacted:${String(v).length}>`;

// An env entry worth naming: optional indentation and "export", an
// UPPER_SNAKE_CASE name, "=" and a value that is not more "=" (base64 padding).
const ENTRY = /^\s*(?:export\s+)?([A-Z][A-Z0-9_]*)\s*=(?=\s*[^=\s])/;

// JSON-escaped spellings of a value, as it may appear in an error message.
const spellings = (v) => {
	const json = JSON.stringify(v).slice(1, -1);
	const ascii = json.replace(/[^\x20-\x7e]/g, (c) => `\\u${c.charCodeAt(0).toString(16).padStart(4, "0")}`);
	const unpadded = v.replace(/=+$/, "");
	return [...new Set([v, json, ascii, ...(unpadded.length >= 8 ? [unpadded] : [])])];
};

const makeRedactor = (secrets, show = new Set(), showErrors = false) => {
	const needles = Object.values(secrets)
		.filter((v) => v.length >= 4)
		.flatMap(spellings)
		.sort((a, b) => b.length - a.length);
	const scrub = (t) => {
		let s = String(t);
		for (const n of needles) s = s.split(n).join("<redacted>");
		return s;
	};

	// Only a multi-line string can be an env block; it renders as its entry names.
	const maskString = (v, key) => {
		if (key !== undefined && show.has(key) && !v.includes("\n")) return scrub(v);
		const lines = v.split(/\r?\n/);
		if (lines.length < 2) return hidden(v);
		return lines
			.map((l) => {
				const m = ENTRY.exec(l);
				if (!m) return l.trim() === "" ? l : hidden(l);
				const value = l.slice(m[0].length).trim();
				const single = !/\s\S+\s*[=:]/.test(value);
				return show.has(m[1]) && single ? scrub(l) : `${m[0]}${hidden(value)}`;
			})
			.join("\n");
	};

	const mask = (v, key, revealed = false) => {
		if (v === null || typeof v === "boolean") return v;
		if (typeof v === "number") return revealed || (key !== undefined && show.has(key)) ? v : hidden(v);
		if (typeof v === "string") return revealed ? scrub(v) : maskString(v, key);
		if (Array.isArray(v)) return v.map((x) => mask(x, undefined, revealed));
		if (typeof v === "object") {
			if (PUBLIC in v && Object.keys(v).length === 1) return mask(v[PUBLIC], key, true);
			// {name|key: X, value: Y} pairs (Vercel, ECS, Kubernetes): show by X.
			const pairName = typeof v.name === "string" ? v.name : typeof v.key === "string" ? v.key : undefined;
			return Object.fromEntries(
				Object.entries(v).map(([k, x]) => {
					// The pair's name is an identifier, not data: print it so an approval
					// shows which variable it sets.
					const isPairName =
						"value" in v && (k === "name" || k === "key") && typeof x === "string" && /^[A-Za-z_][A-Za-z0-9_.-]*$/.test(x);
					const shown =
						revealed || isPairName || show.has(k) || (k === "value" && pairName !== undefined && show.has(pairName));
					return [scrub(k), mask(x, k, shown)];
				}),
			);
		}
		return hidden(String(v));
	};

	// Free text (errors, non-JSON replies) is masked whole unless --show-errors.
	const maskText = (t) => (showErrors ? scrub(t) : hidden(t));

	return { mask, maskText, scrub };
};

// The envelope keeps only fields that never carry call data.
const render = (result, redactor) => {
	const { mask, maskText } = redactor;
	const status = (v) => (typeof v === "string" && /^[a-z][a-z-]{0,31}$/.test(v) ? v : hidden(String(v)));
	let p = result?.structuredContent ?? result?.content?.map((c) => c.text).join("\n") ?? result;
	if (typeof p === "string") {
		try {
			p = JSON.parse(p);
		} catch {
			return maskText(p);
		}
	}
	if (p?.status === "approval-required" || p?.status === "input-required") {
		return { status: p.status, requestId: p.requestId, tool: p.invocation?.tool, input: mask(p.invocation?.input) };
	}
	const e = p?.execution;
	if (e) {
		return {
			status: status(p.status),
			ok: e.ok === true,
			...(e.ok ? { value: mask(e.value) } : { error: { kind: e.error?.kind, message: maskText(e.error?.message ?? "") } }),
			toolCalls: (Array.isArray(e.toolCalls) ? e.toolCalls : []).map((c) => ({
				name: typeof c?.name === "string" && /^[a-z][A-Za-z0-9_.-]{0,127}$/.test(c.name) ? c.name : hidden(String(c?.name)),
				outcome: status(c?.outcome),
			})),
		};
	}
	return { status: status(p?.status), response: mask(p) };
};

// Runs before every network call: a redactor that leaks is worse than none.
// Each shape below leaked in an earlier version or in review.
const selftest = () => {
	const S = "Zq9fakeSECRETzq";
	// base64 fakes built at run time (literals trip gitleaks); lengths chosen
	// for "==" and "=" padding.
	const b64 = (t) => Buffer.from(t).toString("base64");
	const B = {
		config: b64("fake-config-x"), // 13 bytes: ==
		pair: b64("fake-pair-xy"), // 12 bytes: none -> add one below
		k8s: b64("fake-k8s-pass"), // ==
		loose: b64("fake-loose-xy"), // ==
		pem1: b64("fake-pem-line-1"), // =
		pem2: b64("fake-pem-line-22"), // ==
		env: b64("fake-env-value-x"), // ==
		bare: b64("fake-bare-line"), // =
	};
	B.pair = b64("fake-pair-xyz1"); // 14 bytes: =
	const PEM = ["-----BEGIN ", "PRIVATE KEY-----"].join("");
	const PEM_END = ["-----END ", "PRIVATE KEY-----"].join("");
	const redactor = makeRedactor(
		{ FAKE: "fake-file-secret", PADDED: "fake-padded-secret==" },
		new Set(["PUBLIC_NAME", "bucket", "applicationId"]),
	);
	const loud = makeRedactor({ PADDED: "fake-padded-secret==" }, new Set(), true);
	const envBlock = [
		"PUBLIC_NAME=visible-value",
		`DB_PASSWORD="quoted ${S}"`,
		`export EXPORTED=${S}`,
		`  INDENTED=${S}`,
		`yaml_key: ${S}`,
		`SPACED = ${S}`,
		`lower_name=${S}`,
		`CONTRASEÑA=${S}`,
		`DATABASE_URL=redis://:${S}@h`,
		"EMPTY=",
	].join("\n");
	const input = {
		applicationId: "app-visible-id",
		env: envBlock,
		STRIPE_SK: S,
		REDIS_URL: `redis://:${S}@h`,
		vars: [
			{ name: "DB_PASSWORD", value: S },
			{ key: "bucket", value: "visible-bucket" },
			{ name: "bucket", value: "visible-bucket-2" },
		],
		token: { nested: S },
		apiKeys: [S],
		pin: 1234,
		header: `Authorization: Bearer ${S}`,
		url: `https://h/x?api_key=${S}`,
		multi: `KEY="line one ${S}\nline two ${S}"`,
		fromFile: "fake-file-secret",
		docker: `docker run -e DB_PASSWORD=${S} img`,
		sameLine: `PUBLIC_NAME=ok DB_PASSWORD=${S}`,
		keyValue: [{ key: "STRIPE_SK", value: S }],
		"contraseña": S,
		start: `${S}\nsecond line`,
		config: { SESSION_SECRET: B.config },
		pairB64: [{ name: "SESSION_SECRET", value: B.pair }],
		k8s: { data: { password: B.k8s } },
		looseB64: [B.loose],
		pem: `${PEM}\n${B.pem1}\n${B.pem2}\n${PEM_END}`,
		envB64: `A_NAME=x\nSESSION_SECRET=${B.env}\n${B.bare}`,
		badPairName: [{ name: [S], value: 1 }],
		public: { [PUBLIC]: { names: ["DB_PASSWORD"], fp: { len: 3, fp: 9 } } },
	};
	const out = [
		JSON.stringify(render({ structuredContent: { status: "approval-required", requestId: "r1", invocation: { tool: "t", input } } }, redactor)),
		JSON.stringify(render({ structuredContent: { status: "completed", execution: { ok: true, value: input, toolCalls: [] } } }, redactor)),
		JSON.stringify(render({ structuredContent: { status: "completed", execution: { ok: false, error: { kind: "X", message: `bad "A=1\\nDB_PASSWORD=${S}\\nfake-file-secret"` } } } }, redactor)),
		render({ content: [{ text: `not json: export X=${S}\nfake-file-secret` }] }, redactor),
		loud.maskText("--show-errors keeps prose but not fake-padded-secret= or fake-padded-secret=="),
	].join("\n");
	const leaks = [
		S,
		"fake-file-secret",
		"1234",
		...Object.values(B).map((v) => v.replace(/=+$/, "")),
		"fake-padded-secret",
	].filter((v) => out.includes(v));
	const kept = ["visible-value", "app-visible-id", "visible-bucket", "visible-bucket-2", '"name":"DB_PASSWORD"', '"key":"STRIPE_SK"', "export EXPORTED=", "SESSION_SECRET=<redacted", '"names"'].filter(
		(v) => !out.includes(v),
	);
	if (leaks.length || kept.length) {
		die(`redaction self-test failed (leaks: ${leaks.length}; lost: ${kept.join(", ") || "none"})`);
	}
	return out;
};

// ---------------------------------------------------------------------------
// MCP over streamable HTTP

const connection = () => {
	if (process.env.EXECUTOR_MCP_URL) {
		return {
			url: process.env.EXECUTOR_MCP_URL,
			headers: process.env.EXECUTOR_MCP_AUTH ? { Authorization: process.env.EXECUTOR_MCP_AUTH } : {},
		};
	}
	let cfg;
	try {
		cfg = JSON.parse(readFileSync(`${homedir()}/.pi/agent/mcp.json`, "utf8")).mcpServers.executor;
	} catch {
		die("no connection: set EXECUTOR_MCP_URL or configure mcpServers.executor in ~/.pi/agent/mcp.json");
	}
	const headers = {};
	for (const [k, v] of Object.entries(cfg.headers ?? {})) {
		headers[k] =
			typeof v === "string" && v.startsWith("!") ? execSync(v.slice(1), { shell: "/bin/bash", encoding: "utf8" }) : v;
	}
	return { url: cfg.url, headers };
};

const mcp = async (calls) => {
	const { url, headers } = connection();
	let session;
	const rpc = async (body) => {
		const res = await fetch(url, {
			method: "POST",
			headers: {
				...headers,
				"Content-Type": "application/json",
				Accept: "application/json, text/event-stream",
				...(session ? { "Mcp-Session-Id": session } : {}),
			},
			body: JSON.stringify(body),
		});
		session = res.headers.get("mcp-session-id") ?? session;
		const text = await res.text();
		if (!res.ok) die(`HTTP ${res.status} from Executor`);
		if (body.id === undefined) return null;
		const data = text.includes("data:")
			? text
					.split("\n")
					.filter((l) => l.startsWith("data:"))
					.map((l) => l.slice(5))
					.pop()
			: text;
		return JSON.parse(data);
	};
	await rpc({
		jsonrpc: "2.0",
		id: 0,
		method: "initialize",
		params: { protocolVersion: "2025-06-18", capabilities: {}, clientInfo: { name: "executor-pipe", version: "1" } },
	});
	await rpc({ jsonrpc: "2.0", method: "notifications/initialized" });
	return rpc({ jsonrpc: "2.0", id: 1, method: "tools/call", params: calls });
};

// ---------------------------------------------------------------------------
// Commands

const args = process.argv.slice(2);
const secretFiles = [];
const show = new Set();
let showErrors = false;
const rest = [];
for (let i = 0; i < args.length; i++) {
	if (args[i] === "--secrets") secretFiles.push(args[++i] ?? die("--secrets needs a file"));
	else if (args[i] === "--show-errors") showErrors = true;
	else if (args[i] === "--show") for (const n of (args[++i] ?? die("--show needs names")).split(",")) show.add(n.trim());
	else rest.push(args[i]);
}
const [cmd, ...pos] = rest;

if (!cmd || cmd === "-h" || cmd === "--help") {
	const lines = readFileSync(new URL(import.meta.url), "utf8").split("\n").slice(1);
	console.log(lines.slice(0, lines.findIndex((l) => !l.startsWith("//"))).join("\n").replace(/^\/\/ ?/gm, ""));
	process.exit(0);
}

if (cmd === "selftest") {
	selftest();
	console.log("redaction self-test: ok");
	process.exit(0);
}

if (cmd === "fp") {
	const [file, name] = pos;
	if (!file || !name) die("usage: executor-pipe fp <file.env> <NAME>");
	const v = readEnvFiles([file])[name];
	if (v === undefined) die(`${name} is not in ${file}`);
	console.log(JSON.stringify({ name, ...fp(v) }));
	process.exit(0);
}

selftest();
const secrets = readEnvFiles(secretFiles);
const redactor = makeRedactor(secrets, show, showErrors);
let call;
if (cmd === "run") {
	const [file] = pos;
	if (!file) die("usage: executor-pipe run <program.js> [--secrets <file.env>]... [--show NAME,...]");
	const missing = new Set();
	const code = readFileSync(file, "utf8").replace(/__([A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*)__/g, (m, name) => {
		if (name in secrets) return JSON.stringify(secrets[name]);
		missing.add(name);
		return m;
	});
	if (missing.size) die(`not in the secrets files: ${[...missing].join(", ")}`);
	call = { name: "execute", arguments: { code: `${PROGRAM_HELPERS}\n${code}` } };
} else if (cmd === "resume") {
	const [requestId, action] = pos;
	if (!requestId || !["accept", "decline", "cancel"].includes(action)) {
		die("usage: executor-pipe resume <requestId> accept|decline|cancel [--secrets <file.env>]... [--show NAME,...]");
	}
	call = {
		name: "resume",
		arguments: { requestId, response: { action, ...(action === "accept" ? { content: {} } : {}) } },
	};
} else {
	die(`unknown command: ${cmd}`);
}

const out = await mcp(call);
const printed = out.error
	? { error: redactor.maskText(JSON.stringify(out.error)) }
	: render(out.result, redactor);
console.log(redactor.scrub(typeof printed === "string" ? printed : JSON.stringify(printed, null, 1)));
