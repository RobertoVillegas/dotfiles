#!/usr/bin/env node
// executor-pipe — run Executor programs that carry secrets without the values
// entering the agent's context. Values are read from env files and spliced into
// the program; every response is redacted before it is printed.
//
// Usage:
//   executor-pipe run <program.js> [--secrets <file.env>]... [--show NAME,...]
//   executor-pipe resume <requestId> accept|decline [--secrets <file.env>]... [--show NAME,...]
//   executor-pipe fp <file.env> <NAME>     local fingerprint of one value
//   executor-pipe selftest                 check the redaction, no network
//
// In <program.js>, __NAME__ becomes the JSON string of NAME from the secrets
// files, and fp(value) returns { len, fp } (the sandbox has no crypto). An
// unknown __NAME__ is an error, so a typo never sends a literal placeholder.
//
// Output masks the value of every NAME=value line (env blocks), whatever the
// name, up to the end of the line; --show lists the names whose values may be
// printed. It also masks every value from --secrets, user:pass@ in URLs, and
// "name": "value" pairs whose name looks secret.
//
// Connection: EXECUTOR_MCP_URL and EXECUTOR_MCP_AUTH, else the "executor"
// server in ~/.pi/agent/mcp.json (a header starting with "!" runs as a shell
// command, as Pi does).
import { execSync } from "node:child_process";
import { readFileSync } from "node:fs";
import { homedir } from "node:os";

const die = (msg) => {
	console.error(`executor-pipe: ${msg}`);
	process.exit(1);
};

// ---------------------------------------------------------------------------
// Secrets and redaction

const MASK = "<redacted>";

const readEnvFiles = (files) => {
	const values = {};
	for (const file of files) {
		for (const line of readFileSync(file, "utf8").split("\n")) {
			const m = /^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$/.exec(line);
			if (!m) continue;
			let v = m[2].trim();
			if (/^(['"]).*\1$/.test(v)) v = v.slice(1, -1);
			values[m[1]] = v;
		}
	}
	return values;
};

// JSON-escaped spellings of a value, as it may appear inside a response.
const spellings = (v) => {
	const json = JSON.stringify(v).slice(1, -1);
	const ascii = json.replace(/[^\x20-\x7e]/g, (c) => `\\u${c.charCodeAt(0).toString(16).padStart(4, "0")}`);
	return [...new Set([v, json, ascii])];
};

// NAME=value at the start of a line; the value runs to the end of the line,
// spaces and quotes included. Applied to real text: JSON responses are parsed
// and each string is redacted after unescaping.
const ENV_LINE = /(^|\n)([A-Z][A-Z0-9_]*)=([^\n]*)/g;
// Same, for text that is not JSON but carries escaped newlines (error messages).
const ENV_LINE_ESCAPED = /(\\n)([A-Z][A-Z0-9_]*)=((?:\\[^n]|[^\\\n])*)/g;
const URL_CREDENTIALS = /\b([a-z][a-z0-9+.-]*:\/\/)[^\s/@:]+:[^\s/@]+@/gi;
const SECRET_KEY_NAME = /(key|secret|pass|token|credential|private|auth|dsn|salt|sign|cookie|session|jwt|cert)/i;

const makeRedactor = (secrets, show = new Set()) => {
	const needles = Object.values(secrets)
		.filter((v) => v.length >= 4)
		.flatMap(spellings)
		.sort((a, b) => b.length - a.length);
	const text = (t) => {
		let s = t;
		for (const n of needles) s = s.split(n).join(MASK);
		const mask = (m, pre, name, value) => (show.has(name) || value === "" ? m : `${pre}${name}=${MASK}`);
		s = s.replace(ENV_LINE, mask).replace(ENV_LINE_ESCAPED, mask);
		return s.replace(URL_CREDENTIALS, `$1${MASK}@`);
	};
	const walk = (v, key) => {
		if (typeof v === "string") return key && SECRET_KEY_NAME.test(key) && !show.has(key) ? MASK : text(v);
		if (Array.isArray(v)) return v.map((x) => walk(x));
		if (v && typeof v === "object") return Object.fromEntries(Object.entries(v).map(([k, x]) => [text(k), walk(x, k)]));
		return v;
	};
	return (out) => {
		try {
			return JSON.stringify(walk(JSON.parse(out)), null, 1);
		} catch {
			return text(out);
		}
	};
};

const FP_SOURCE = `const fp = (v) => { let h = 0; for (const c of String(v)) h = (h * 31 + c.charCodeAt(0)) >>> 0; return { len: String(v).length, fp: h }; };`;
const fp = (v) => {
	let h = 0;
	for (const c of String(v)) h = (h * 31 + c.charCodeAt(0)) >>> 0;
	return { len: String(v).length, fp: h };
};

// Runs before every network call: a redactor that leaks is worse than none.
// Cases come from review: quoted values, spaces, names that do not look
// secret, credentials inside URLs, non-ASCII values escaped as \uXXXX.
const selftest = () => {
	const fake = { FAKE_TOKEN: "fake-token-value", SHORT: "abcd", ACCENT: "contraseña-falsa" };
	const redact = makeRedactor(fake, new Set(["PUBLIC_NAME"]));
	const env = [
		"PUBLIC_NAME=visible-value",
		'DB_PASSWORD="quoted secret value"',
		"SECRET_KEY=has space inside",
		"DATABASE_URL=postgres://dbuser:dbpass-fake@db:5432/app",
		"SENTRY_DSN=https://fakedsnkey@sentry.example/1",
		"SESSION_SALT=salty-fake-salt",
		"JWT=eyJfake.jwt.value",
		"EMPTY=",
	].join("\n");
	const sample = JSON.stringify({
		env,
		nested: { apiKey: "fake-api-key-value", sentryDsn: "fake-dsn-value", note: "uses fake-token-value and abcd" },
		url: "see https://someuser:fake-url-pass@host.example/path",
	});
	const escaped = JSON.stringify({ v: "x contraseña-falsa y" }).replace(/ñ/g, "\\u00f1"); // parsed back to ñ
	const errorText = 'Error: bad env "A=1\\nDB_PASSWORD=\\"quoted secret value\\"\\nB=2"';
	const out = `${redact(sample)}\n${redact(escaped)}\n${redact(env)}\n${redact(errorText)}`;
	const leaks = [
		"quoted secret value",
		"space inside",
		"dbpass-fake",
		"fakedsnkey",
		"salty-fake-salt",
		"eyJfake",
		"fake-api-key-value",
		"fake-dsn-value",
		"fake-token-value",
		"abcd",
		"fake-url-pass",
		"someuser",
		"contrase",
	].filter((v) => out.includes(v));
	const kept = ["PUBLIC_NAME=visible-value", "EMPTY=", "DB_PASSWORD=", "DATABASE_URL="].filter((v) => !out.includes(v));
	if (leaks.length || kept.length) {
		die(`redaction self-test failed (leaks: ${leaks.join(", ") || "none"}; lost: ${kept.join(", ") || "none"})`);
	}
	return out;
};

// ---------------------------------------------------------------------------
// MCP over streamable HTTP

const connection = () => {
	if (process.env.EXECUTOR_MCP_URL) {
		return {
			url: process.env.EXECUTOR_MCP_URL,
			headers: process.env.EXECUTOR_MCP_AUTH ? { Authorization: process.env.EXECUTOR_MCP_AUTH } : {},
		};
	}
	let cfg;
	try {
		cfg = JSON.parse(readFileSync(`${homedir()}/.pi/agent/mcp.json`, "utf8")).mcpServers.executor;
	} catch {
		die("no connection: set EXECUTOR_MCP_URL or configure mcpServers.executor in ~/.pi/agent/mcp.json");
	}
	const headers = {};
	for (const [k, v] of Object.entries(cfg.headers ?? {})) {
		headers[k] =
			typeof v === "string" && v.startsWith("!") ? execSync(v.slice(1), { shell: "/bin/bash", encoding: "utf8" }) : v;
	}
	return { url: cfg.url, headers };
};

const mcp = async (calls) => {
	const { url, headers } = connection();
	let session;
	const rpc = async (body) => {
		const res = await fetch(url, {
			method: "POST",
			headers: {
				...headers,
				"Content-Type": "application/json",
				Accept: "application/json, text/event-stream",
				...(session ? { "Mcp-Session-Id": session } : {}),
			},
			body: JSON.stringify(body),
		});
		session = res.headers.get("mcp-session-id") ?? session;
		const text = await res.text();
		if (!res.ok) die(`HTTP ${res.status} from Executor`);
		if (body.id === undefined) return null;
		const data = text.includes("data:")
			? text
					.split("\n")
					.filter((l) => l.startsWith("data:"))
					.map((l) => l.slice(5))
					.pop()
			: text;
		return JSON.parse(data);
	};
	await rpc({
		jsonrpc: "2.0",
		id: 0,
		method: "initialize",
		params: { protocolVersion: "2025-06-18", capabilities: {}, clientInfo: { name: "executor-pipe", version: "1" } },
	});
	await rpc({ jsonrpc: "2.0", method: "notifications/initialized" });
	return rpc({ jsonrpc: "2.0", id: 1, method: "tools/call", params: calls });
};

// Approvals and input requests echo the whole call input: keep what the user
// needs to decide (tool and redacted input) and drop the rest.
const summarize = (result) => {
	const payload = result?.structuredContent ?? result?.content?.map((c) => c.text).join("\n") ?? result;
	let p = payload;
	if (typeof p === "string") {
		try {
			p = JSON.parse(p);
		} catch {
			return p;
		}
	}
	if (p?.status === "approval-required" || p?.status === "input-required") {
		return JSON.stringify(
			{ status: p.status, requestId: p.requestId, tool: p.invocation?.tool, input: p.invocation?.input },
			null,
			1,
		);
	}
	return JSON.stringify(p);
};

// ---------------------------------------------------------------------------
// Commands

const args = process.argv.slice(2);
const secretFiles = [];
const show = new Set();
const rest = [];
for (let i = 0; i < args.length; i++) {
	if (args[i] === "--secrets") secretFiles.push(args[++i] ?? die("--secrets needs a file"));
	else if (args[i] === "--show") for (const n of (args[++i] ?? die("--show needs names")).split(",")) show.add(n.trim());
	else rest.push(args[i]);
}
const [cmd, ...pos] = rest;

if (!cmd || cmd === "-h" || cmd === "--help") {
	const lines = readFileSync(new URL(import.meta.url), "utf8").split("\n").slice(1);
	console.log(lines.slice(0, lines.findIndex((l) => !l.startsWith("//"))).join("\n").replace(/^\/\/ ?/gm, ""));
	process.exit(0);
}

if (cmd === "selftest") {
	console.log(selftest());
	console.log("redaction self-test: ok");
	process.exit(0);
}

if (cmd === "fp") {
	const [file, name] = pos;
	if (!file || !name) die("usage: executor-pipe fp <file.env> <NAME>");
	const v = readEnvFiles([file])[name];
	if (v === undefined) die(`${name} is not in ${file}`);
	console.log(JSON.stringify({ name, ...fp(v) }));
	process.exit(0);
}

selftest();
const secrets = readEnvFiles(secretFiles);
const redact = makeRedactor(secrets, show);
let call;
if (cmd === "run") {
	const [file] = pos;
	if (!file) die("usage: executor-pipe run <program.js> [--secrets <file.env>]...");
	const missing = new Set();
	const code = readFileSync(file, "utf8").replace(/__([A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*)__/g, (m, name) => {
		if (name in secrets) return JSON.stringify(secrets[name]);
		missing.add(name);
		return m;
	});
	if (missing.size) die(`not in the secrets files: ${[...missing].join(", ")}`);
	call = { name: "execute", arguments: { code: `${FP_SOURCE}\n${code}` } };
} else if (cmd === "resume") {
	const [requestId, action] = pos;
	if (!requestId || !["accept", "decline", "cancel"].includes(action)) {
		die("usage: executor-pipe resume <requestId> accept|decline|cancel [--secrets <file.env>]...");
	}
	call = {
		name: "resume",
		arguments: { requestId, response: { action, ...(action === "accept" ? { content: {} } : {}) } },
	};
} else {
	die(`unknown command: ${cmd}`);
}

const out = await mcp(call);
console.log(redact(out.error ? JSON.stringify(out.error) : summarize(out.result)));
