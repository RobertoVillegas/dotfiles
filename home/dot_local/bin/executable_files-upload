#!/usr/bin/env bash
# files-upload — upload a file to https://files.roberto.lol and print its public URL.
# Needs only bash + curl (+ openssl for --secret). Auth: $FILES_UPLOAD_TOKEN or ~/.config/files-upload/token.
set -euo pipefail

BASE="${FILES_UPLOAD_BASE:-https://files.roberto.lol}"
TOKEN_FILE="${FILES_UPLOAD_TOKEN_FILE:-$HOME/.config/files-upload/token}"

usage() {
  cat <<'EOF'
Usage:
  files-upload [options] <file> [dest]
  files-upload --secret [--expires 7d] [--max-downloads N] <file>
  files-upload --rm <url-or-key>
  files-upload --set-token < token-file     # store the upload token (mode 600)

dest (optional):
  name          use "name" as the slug (extension kept, random suffix added)
  dir/          put the file under that folder, slug from the file name
  dir/name      both

Options:
  --json             print JSON {key,url,viewer,size,contentType}
  --title "Text"     title for link previews (default: file name)
  --no-suffix        don't add the random suffix (URL becomes guessable)
  --overwrite        replace an existing object with the same key
  --type MIME        force the Content-Type
  --rm URL|KEY       delete a previously uploaded file (also works for --secret links)

Encrypted shares (for .env, dumps, keys, anything sensitive):
  --secret           encrypt locally before uploading; the key goes only in the
                     link after '#', which never reaches the server
  --expires DUR      lifetime: 30m, 12h, 7d... (default 7d, max 90d)
  --max-downloads N  stop serving after N downloads (default: unlimited)
  --set-token        read the token from stdin into ~/.config/files-upload/token
  -h, --help
Env: FILES_UPLOAD_TOKEN, FILES_UPLOAD_TOKEN_FILE, FILES_UPLOAD_BASE
EOF
}

die() { echo "files-upload: $*" >&2; exit 1; }

token() {
  if [[ -n "${FILES_UPLOAD_TOKEN:-}" ]]; then printf '%s' "$FILES_UPLOAD_TOKEN"
  elif [[ -r "$TOKEN_FILE" ]]; then tr -d '\n\r ' < "$TOKEN_FILE"
  else die "no token: set FILES_UPLOAD_TOKEN or create $TOKEN_FILE"; fi
}

slugify() {
  local s
  if command -v perl >/dev/null; then
    s=$(printf '%s' "$1" | perl -CSD -MUnicode::Normalize -pe '$_=NFD($_); s/\pM//g; s/[^\x00-\x7f]//g' 2>/dev/null) || s="$1"
  else
    s=$(printf '%s' "$1" | iconv -f UTF-8 -t ASCII//TRANSLIT 2>/dev/null) || s="$1"
  fi
  s=$(printf '%s' "$s" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
  printf '%s' "${s:0:60}" | sed -E 's/-+$//'
}

rand() { # n chars of [a-z0-9]; no pipes (pipefail + SIGPIPE)
  local chars=abcdefghijklmnopqrstuvwxyz0123456789 out="" b
  for b in $(od -An -N"${1:-8}" -tu1 /dev/urandom); do out+="${chars:b%36:1}"; done
  printf '%s' "$out"
}

urlenc() { # percent-encode UTF-8 bytes, keep slashes
  local LC_ALL=C s="$1" out="" c i
  for (( i=0; i<${#s}; i++ )); do
    c="${s:i:1}"
    case "$c" in [a-zA-Z0-9._~/-]) out+="$c" ;; *) printf -v c "%d" "'$c"; out+=$(printf "%%%02X" $(( c & 255 ))) ;; esac
  done
  printf '%s' "$out"
}

mime_for() {
  local f="$1" e
  e=$(printf '%s' "${f##*.}" | tr '[:upper:]' '[:lower:]')
  [[ "$f" == *.* ]] || e=""
  case "$e" in
    pdf) echo application/pdf ;;
    png) echo image/png ;; jpg|jpeg) echo image/jpeg ;; gif) echo image/gif ;;
    webp) echo image/webp ;; avif) echo image/avif ;; svg) echo image/svg+xml ;; heic) echo image/heic ;;
    mp4|m4v) echo video/mp4 ;; webm) echo video/webm ;; mov) echo video/quicktime ;;
    mp3) echo audio/mpeg ;; m4a) echo audio/mp4 ;; wav) echo audio/wav ;; ogg|opus) echo audio/ogg ;;
    txt|log) echo "text/plain; charset=utf-8" ;; md) echo "text/markdown; charset=utf-8" ;;
    csv) echo "text/csv; charset=utf-8" ;; json) echo "application/json; charset=utf-8" ;;
    zip) echo application/zip ;; gz|tgz) echo application/gzip ;;
    docx) echo application/vnd.openxmlformats-officedocument.wordprocessingml.document ;;
    xlsx) echo application/vnd.openxmlformats-officedocument.spreadsheetml.sheet ;;
    pptx) echo application/vnd.openxmlformats-officedocument.presentationml.presentation ;;
    *) if command -v file >/dev/null; then file -b --mime-type "$f"; else echo application/octet-stream; fi ;;
  esac
}

json_field() { # minimal extractor for flat JSON string/number fields
  sed -nE "s/.*\"$1\": *\"?([^\",]*)\"?,?\$/\1/p" | head -1
}

tohex() { od -An -v -tx1 | tr -d ' \n'; }
unhex() { printf "$(printf '%s' "$1" | sed 's/../\\x&/g')"; }
b64url() { base64 | tr '+/' '-_' | tr -d '=\n'; }
hmac_hex() { # hmac_hex <hexkey> <message> -> hex digest
  printf '%s' "$2" | openssl dgst -sha256 -mac HMAC -macopt "hexkey:$1" -binary | tohex
}
json_esc() { # escape for a JSON string; control characters become "_"
  local s; s=$(printf '%s' "$1" | LC_ALL=C tr '\000-\037' '_')
  s=${s//\\/\\\\}; s=${s//\"/\\\"}
  printf '%s' "$s"
}
duration_secs() { # 30m | 12h | 7d -> seconds
  [[ "$1" =~ ^([0-9]+)([mhd])$ ]] || die "bad --expires '$1' (use e.g. 30m, 12h, 7d)"
  local n=$((10#${BASH_REMATCH[1]}))
  case "${BASH_REMATCH[2]}" in m) echo $(( n * 60 )) ;; h) echo $(( n * 3600 )) ;; d) echo $(( n * 86400 )) ;; esac
}

# Encrypted share. Format "FRS1" | iv | AES-256-CBC(header "\n" file) | HMAC-SHA256 tag,
# with encKey = HMAC(K,"enc") and macKey = HMAC(K,"mac"). K travels only in the URL fragment.
# The page at /s/<id> (files-roberto-lol, src/secret.js) does the same in reverse with WebCrypto.
secret_upload() {
  local src="$1" secs max fname ctype k ek mk iv resp code body url expires_at
  [[ -f "$src" && -r "$src" ]] || die "not a readable file: $src"
  command -v openssl >/dev/null || die "--secret needs openssl"
  secs=$(duration_secs "${EXPIRES:-7d}")
  (( secs >= 60 && secs <= 90 * 86400 )) || die "--expires must be between 1m and 90d"
  max=""
  if [[ -n "$MAX_DL" ]]; then
    [[ "$MAX_DL" =~ ^[0-9]+$ ]] && (( 10#$MAX_DL >= 1 && 10#$MAX_DL <= 1000 )) || die "--max-downloads must be 1..1000"
    max=$((10#$MAX_DL))
  fi
  fname=$(basename "$src")
  ctype="${FORCE_TYPE:-$(mime_for "$src")}"

  k=$(openssl rand -hex 32)
  ek=$(hmac_hex "$k" enc); mk=$(hmac_hex "$k" mac)
  iv=$(openssl rand -hex 16)
  tmp=$(mktemp -d); trap 'rm -rf "${tmp:-}"' EXIT  # global: the trap runs after this function returns
  { printf 'FRS1'; unhex "$iv"; } > "$tmp/blob"
  { printf '{"n":"%s","t":"%s"}\n' "$(json_esc "$fname")" "$(json_esc "$ctype")"; cat "$src"; } \
    | openssl enc -aes-256-cbc -K "$ek" -iv "$iv" >> "$tmp/blob" || die "encryption failed"
  openssl dgst -sha256 -mac HMAC -macopt "hexkey:$mk" -binary < "$tmp/blob" > "$tmp/tag"
  cat "$tmp/tag" >> "$tmp/blob"

  local hdrs=(-H "Authorization: Bearer $(token)" -H "Content-Type: application/octet-stream" -H "X-Expires-In: $secs")
  [[ -n "$max" ]] && hdrs+=(-H "X-Max-Downloads: $max")
  resp=$(curl -sS -X POST "${hdrs[@]}" --data-binary "@$tmp/blob" -w $'\n%{http_code}' "$BASE/s") \
    || die "upload request failed"
  code="${resp##*$'\n'}"; body="${resp%$'\n'*}"
  [[ "$code" == 201 ]] || die "upload failed (HTTP $code): $body"
  url="$(printf '%s\n' "$body" | json_field url)#$(unhex "$k" | b64url)"
  expires_at=$(printf '%s\n' "$body" | json_field expiresAt)

  if (( JSON )); then
    printf '{"url":"%s","expiresAt":"%s","maxDownloads":%s,"size":%s}\n' \
      "$url" "$expires_at" "${max:-null}" "$(printf '%s\n' "$body" | json_field size)"
  else
    echo "$url"
    echo "encrypted · expires $expires_at · downloads: ${max:-unlimited}" >&2
  fi
}

JSON=0 TITLE="" SUFFIX=1 OVERWRITE=0 FORCE_TYPE="" RM="" ARGS=()
SECRET=0 EXPIRES="" MAX_DL="" PLAIN_OPTS=()
while (( $# )); do
  case "$1" in
    --json) JSON=1 ;;
    --title) TITLE="${2:?}"; PLAIN_OPTS+=(--title); shift ;;
    --no-suffix) SUFFIX=0; PLAIN_OPTS+=(--no-suffix) ;;
    --overwrite) OVERWRITE=1; PLAIN_OPTS+=(--overwrite) ;;
    --type) FORCE_TYPE="${2:?}"; shift ;;
    --secret) SECRET=1 ;;
    --expires) EXPIRES="${2:?}"; shift ;;
    --max-downloads) MAX_DL="${2:?}"; shift ;;
    --rm) RM="${2:?}"; shift ;;
    --set-token)
      t=$(tr -d '\n\r ' ); [[ ${#t} -ge 20 ]] || die "token on stdin is empty or too short"
      code=$(curl -sS -o /dev/null -w '%{http_code}' -X DELETE -H "Authorization: Bearer $t" "$BASE/.token-check") || die "cannot reach $BASE"
      [[ "$code" == 404 ]] || die "token rejected by $BASE (HTTP $code)"
      mkdir -p "$(dirname "$TOKEN_FILE")"; chmod 700 "$(dirname "$TOKEN_FILE")"
      (umask 077; printf '%s\n' "$t" > "$TOKEN_FILE"); chmod 600 "$TOKEN_FILE"
      echo "token saved to $TOKEN_FILE and accepted by $BASE"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; ARGS+=("$@"); break ;;
    -*) die "unknown option $1 (see --help)" ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done

if [[ -n "$RM" ]]; then
  key="${RM%%#*}"; key="${key#"$BASE"/}"; key="${key#v/}"
  curl -fsS -X DELETE -H "Authorization: Bearer $(token)" "$BASE/$(urlenc "$key")" >/dev/null \
    || die "delete failed for $key"
  (( JSON )) && printf '{"deleted":"%s"}\n' "$key" || echo "deleted $key"
  exit 0
fi

(( SECRET )) || [[ -z "$EXPIRES$MAX_DL" ]] || die "--expires and --max-downloads need --secret"
if (( SECRET )); then
  (( ${#PLAIN_OPTS[@]} == 0 )) || die "${PLAIN_OPTS[0]} does not apply to --secret"
  (( ${#ARGS[@]} == 1 )) || die "--secret takes exactly one file and no dest"
  secret_upload "${ARGS[0]}"
  exit 0
fi

(( ${#ARGS[@]} >= 1 && ${#ARGS[@]} <= 2 )) || { usage >&2; exit 2; }
src="${ARGS[0]}"; dest="${ARGS[1]:-}"
[[ -f "$src" && -r "$src" ]] || die "not a readable file: $src"

fname=$(basename "$src")
ext=""; stem="$fname"
if [[ "$fname" == *.* && "${fname%.*}" != "" ]]; then
  ext=$(printf '%s' "${fname##*.}" | tr '[:upper:]' '[:lower:]'); stem="${fname%.*}"
fi

dir="" name=""
if [[ -n "$dest" ]]; then
  if [[ "$dest" == */ ]]; then dir="$dest"; else dir=$(dirname "$dest"); name=$(basename "$dest"); [[ "$dir" == "." ]] && dir=""; fi
fi
# sanitize folder path segment by segment
cleandir=""
if [[ -n "$dir" ]]; then
  IFS='/' read -r -a segs <<< "$dir"
  for s in "${segs[@]}"; do s=$(slugify "$s"); [[ -n "$s" ]] && cleandir+="$s/"; done
fi
[[ "$cleandir" == v/* ]] && die "'v/' is reserved"
if [[ -n "$name" && -n "$ext" && "$(printf '%s' "${name##*.}" | tr '[:upper:]' '[:lower:]')" == "$ext" ]]; then name="${name%.*}"; fi
slug=$(slugify "${name:-$stem}"); [[ -n "$slug" ]] || slug="file"
(( SUFFIX )) && slug="$slug-$(rand 8)"
key="${cleandir}${slug}${ext:+.$ext}"

ctype="${FORCE_TYPE:-$(mime_for "$src")}"
q=""; (( OVERWRITE )) && q="?overwrite=1"

hdrs=(-H "Authorization: Bearer $(token)" -H "Content-Type: $ctype" -H "X-Filename: $(urlenc "$fname")")
[[ -n "$TITLE" ]] && hdrs+=(-H "X-Title: $(urlenc "$TITLE")")

resp=$(curl -sS -X PUT "${hdrs[@]}" --data-binary "@$src" -w $'\n%{http_code}' "$BASE/$(urlenc "$key")$q") \
  || die "upload request failed"
code="${resp##*$'\n'}"; body="${resp%$'\n'*}"
[[ "$code" == 201 ]] || die "upload failed (HTTP $code): $body"

if (( JSON )); then
  printf '%s\n' "$body"
else
  printf '%s\n' "$body" | json_field url
  v=$(printf '%s\n' "$body" | json_field viewer); [[ -n "$v" ]] && echo "$v"
fi
exit 0
