#!/bin/sh
set -eu

# The plugin binary lives inside herdr's plugin directory under a hashed path
# (mirror-00154761637c today), which changes whenever the plugin is reinstalled.
# Resolve it through herdr instead of hardcoding it.

export PATH="/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$HOME/.local/bin:$PATH"

if ! command -v herdr >/dev/null 2>&1; then
	echo "herdr no está disponible." >&2
	exit 1
fi

root="$(herdr plugin list --json 2>/dev/null |
	jq -r '.result.plugins[]? | select(.plugin_id == "mirror") | .plugin_root')"

if [ -z "$root" ]; then
	echo "El plugin herdr-mirror no está instalado. Instálalo con:" >&2
	echo "  herdr plugin install nikok6/herdr-mirror --ref <commit> --yes" >&2
	exit 1
fi

bin="$root/target/release/herdr-mirror"

if [ ! -x "$bin" ]; then
	echo "El plugin está instalado pero su binario falta en $bin." >&2
	echo "Reinstálalo para que vuelva a descargarlo." >&2
	exit 1
fi

exec "$bin" "$@"
