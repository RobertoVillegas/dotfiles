#!/bin/sh
set -u

# Headless Orca runtime for the devbox profile. `orca serve` is the documented
# way to run Orca without a desktop window; the runtime owns the projects,
# worktrees, terminals and agent sessions, so clients can come and go without
# taking the work with them. Driven by a launchd agent on macOS.
#
# Orca always binds 0.0.0.0 and offers no bind-address flag, so the tailnet
# boundary is enforced by Tailscale Serve terminating TLS in front of loopback
# rather than by the listener itself. --pairing-address only changes the address
# advertised to clients, which is why it names the Serve frontend, not the port
# Orca actually listens on.

port="${ORCA_SERVE_PORT:-6768}"
proxy_port="${ORCA_SERVE_PROXY_PORT:-6769}"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/orca"
log_file="$state_dir/serve.log"

mkdir -p "$state_dir"

timestamp() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }

export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.local/share/mise}"
# Shims first, matching dotfiles-autoupdate: codex and pi resolve only through
# mise, and Orca spawns them from whatever PATH it inherits from launchd.
PATH="$MISE_DATA_DIR/shims:$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

for tool in orca tailscale jq; do
	if ! command -v "$tool" >/dev/null 2>&1; then
		printf '%s aborted: %s is not on PATH\n' "$(timestamp)" "$tool" >>"$log_file"
		exit 1
	fi
done

dns_name="$(tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // empty')"
dns_name="${dns_name%.}"

if [ -z "$dns_name" ]; then
	printf '%s aborted: tailscale has no MagicDNS name for this host\n' "$(timestamp)" >>"$log_file"
	exit 1
fi

# Idempotent: re-running must not disturb the unrelated Serve routes this host
# already publishes.
if ! tailscale serve status 2>/dev/null | grep -q ":$proxy_port"; then
	if ! tailscale serve --bg "--https=$proxy_port" "http://127.0.0.1:$port" >>"$log_file" 2>&1; then
		printf '%s aborted: could not publish the Serve route on %s\n' "$(timestamp)" "$proxy_port" >>"$log_file"
		exit 1
	fi
fi

printf '\n=== %s orca serve (wss://%s:%s -> 127.0.0.1:%s) ===\n' \
	"$(timestamp)" "$dns_name" "$proxy_port" "$port" >>"$log_file"

# --no-pairing by default: the durable service exists for devices that are
# already paired, and a restart would otherwise mint a fresh device token into
# the log on every boot. Pair a new client by stopping the agent and running
# `orca serve` by hand, with --mobile-pairing for a phone.
pairing_flag="--no-pairing"
if [ "${ORCA_SERVE_PAIRING:-0}" = "1" ]; then
	pairing_flag=""
fi

# shellcheck disable=SC2086
exec orca serve \
	--port "$port" \
	--pairing-address "wss://$dns_name:$proxy_port" \
	$pairing_flag >>"$log_file" 2>&1
