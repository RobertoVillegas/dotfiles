#!/bin/sh
set -eu
: "${PYTORCH_IMAGE:?Set PYTORCH_IMAGE to a PyTorch CUDA image pinned by digest}"
case "$PYTORCH_IMAGE" in *@sha256:*) ;; *) echo 'PYTORCH_IMAGE must be pinned by digest' >&2; exit 2;; esac
checkpoint_dir="${CHECKPOINT_DIR:-$HOME/checkpoints/rl-smoke}"
case "$checkpoint_dir" in /mnt/*) echo 'checkpoint directory must be in the Linux filesystem' >&2; exit 2;; esac
mkdir -p "$checkpoint_dir"
script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repo_smoke="${DOTFILES_SMOKE_DIR:-$HOME/.local/share/devbox/smoke}"
CHECKPOINT_DIR="$checkpoint_dir" PYTORCH_IMAGE="$PYTORCH_IMAGE" docker compose -f "$repo_smoke/compose.yaml" up --abort-on-container-exit --exit-code-from cuda-smoke