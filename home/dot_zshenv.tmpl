export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.local/share/mise}"

# Agent CLIs are host tools: a mise shim for an `npm:` package resolves its node
# from the current directory, so a project pinned to an older runtime takes the
# agent down with it. ~/.agents/bin wraps those CLIs and starts them on the node
# of the global pin instead, which means it has to resolve before the shims.
# brew shellenv, OrbStack, mise activation and this file all reorder PATH, so the
# function is defined here -- the one file every zsh reads -- and called again by
# each layer that touches PATH. See home/dot_agents/bin and dot_zshrc.tmpl.
_agent_path() {
  [[ -d "$HOME/.agents/bin" ]] || return 0
  path=("$HOME/.agents/bin" ${path:#"$HOME/.agents/bin"})
}

{{ if eq .chezmoi.os "darwin" -}}
export PATH="$MISE_DATA_DIR/shims:$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
{{ else -}}
export PATH="$MISE_DATA_DIR/shims:$HOME/.local/bin:/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:$PATH"
{{ end -}}
_agent_path
{{ if and (eq .target "wsl") (eq .gpu "nvidia") -}}
[[ -d /usr/lib/wsl/lib ]] && export PATH="/usr/lib/wsl/lib:$PATH"
{{ end -}}

# Runtime managers that predate mise leave env vars and PATH entries behind that
# still shadow it: proto keeps shims for node, npm, pnpm and bun, and bun and
# pnpm each ship their own installer directory. mise is the only owner, so strip
# the rest before anything else runs.
unset PROTO_HOME NPM_CONFIG_PREFIX npm_config_prefix PNPM_HOME BUN_INSTALL
path=(${path:#${HOME}/.proto/*})
path=(${path:#${HOME}/.bun/*})
path=(${path:#${HOME}/Library/pnpm})

# Keep OrbStack's clients available without letting its bundled runtimes
# override the versions selected by mise.
[[ -d "$HOME/.orbstack/bin" ]] && export PATH="$PATH:$HOME/.orbstack/bin"
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

{{ if eq .profile "dev" -}}
# Mark browser-derived output as untrusted content when agents automate pages.
export AGENT_BROWSER_CONTENT_BOUNDARIES=1
{{ end -}}
{{ if and (eq .profile "dev") (eq .role "devbox") -}}
# Portless owns ephemeral HTTP routes. Tailscale exposure follows the child
# process lifecycle; Funnel and LAN exposure stay off by default.
export PORTLESS_PORT=1355
export PORTLESS_HTTPS=0
export PORTLESS_TAILSCALE=1
export PORTLESS_FUNNEL=0
export PORTLESS_LAN=0
export PORTLESS_SYNC_HOSTS=0
{{ end -}}
