export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
plugins=(git)
[[ -r "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# Pure prompt, installed by Homebrew.
if command -v brew >/dev/null 2>&1; then
  fpath=("$(brew --prefix)/share/zsh/site-functions" $fpath)
fi
autoload -Uz promptinit && promptinit
prompt pure 2>/dev/null || true

[[ -d "$HOME/go/bin" ]] && export PATH="$HOME/go/bin:$PATH"
[[ -d "$HOME/.druk/bin" ]] && export PATH="$HOME/.druk/bin:$PATH"
[[ -d "$HOME/.opencode/bin" ]] && export PATH="$HOME/.opencode/bin:$PATH"

# Homebrew libraries used by local builds. These kegs are not linked into the
# prefix, so a build has to be pointed at them explicitly -- psql and anything
# compiling against ICU need the flags, not just the PATH entry.
if command -v brew >/dev/null 2>&1; then
  brew_prefix="$(brew --prefix)"
  # Built fresh and assigned once: appending to the exported value would make
  # the flags grow every time this file is re-sourced.
  keg_ld="" keg_cpp="" keg_pc=""
  for keg in libpq icu4c@76; do
    keg_dir="$brew_prefix/opt/$keg"
    [[ -d "$keg_dir" ]] || continue
    [[ -d "$keg_dir/bin" ]] && export PATH="$keg_dir/bin:$PATH"
    [[ -d "$keg_dir/sbin" ]] && export PATH="$keg_dir/sbin:$PATH"
    keg_ld="-L$keg_dir/lib${keg_ld:+ $keg_ld}"
    keg_cpp="-I$keg_dir/include${keg_cpp:+ $keg_cpp}"
    keg_pc="$keg_dir/lib/pkgconfig${keg_pc:+:$keg_pc}"
  done
  [[ -n "$keg_ld" ]] && export LDFLAGS="$keg_ld"
  [[ -n "$keg_cpp" ]] && export CPPFLAGS="$keg_cpp"
  [[ -n "$keg_pc" ]] && export PKG_CONFIG_PATH="$keg_pc"
  unset keg_ld keg_cpp keg_pc

  # Java is keg-only too, and JAVA_HOME is what build tools actually read.
  for jdk in openjdk@21; do
    [[ -d "$brew_prefix/opt/$jdk" ]] || continue
    export JAVA_HOME="$brew_prefix/opt/$jdk"
    export PATH="$JAVA_HOME/bin:$PATH"
  done
  unset brew_prefix keg keg_dir jdk
fi

command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

if command -v brew >/dev/null 2>&1; then
  fzf_prefix="$(brew --prefix)/opt/fzf/shell"
  [[ -r "$fzf_prefix/completion.zsh" ]] && source "$fzf_prefix/completion.zsh"
  [[ -r "$fzf_prefix/key-bindings.zsh" ]] && source "$fzf_prefix/key-bindings.zsh"
  unset fzf_prefix
fi
# Written by `fzf --install` on machines that ran it before Homebrew's fzf.
[[ -r "$HOME/.fzf.zsh" ]] && source "$HOME/.fzf.zsh"

{{ if and (eq .chezmoi.os "darwin") (eq .role "workstation") -}}
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
[[ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]] && alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
{{ end -}}

alias ls="eza"
alias ll="eza -l -g --git"
alias llt="eza -1 --icons --tree --git-ignore"
alias cat="bat"
alias ga="git add -A"
alias gc="git commit -m"
alias gp="git push"
alias gl="git log --oneline --graph --decorate -20"
alias gco="git checkout"
alias gst="git status -sb"

[[ -r "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"

_uv_comp="$HOME/.cache/uv-completions.zsh"
if command -v uv >/dev/null 2>&1; then
  if [[ ! -f "$_uv_comp" || "$(command -v uv)" -nt "$_uv_comp" ]]; then
    mkdir -p "$HOME/.cache"
    { uv generate-shell-completion zsh; uvx --generate-shell-completion zsh; } >| "$_uv_comp"
  fi
  source "$_uv_comp"
fi
unset _uv_comp

# worktrunk: shell integration gives wt switch its directory jump.
command -v wt >/dev/null 2>&1 && eval "$(wt config shell init zsh)"

# sup prints the chosen repo to a temp file and cannot cd the calling shell
# itself, so this wrapper is what turns a selection into an actual jump.
if command -v sup >/dev/null 2>&1; then
  sup() {
    rm -f /tmp/sup-selection
    command sup "$@"
    if [[ -f /tmp/sup-selection ]]; then
      cd "$(cat /tmp/sup-selection)"
      rm -f /tmp/sup-selection
    fi
  }
fi

# Manual Homebrew maintenance. dotfiles-autoupdate deliberately leaves casks
# alone; this is where they get upgraded, with someone watching.
brewm() {
  local SECONDS=0 doctor=false
  while [[ "$1" == -* ]]; do
    case "$1" in
      --doctor|-d) doctor=true; shift ;;
      *) echo "Usage: brewm [--doctor]"; return 1 ;;
    esac
  done

  brew update || return 1
  brew upgrade
  {{ if eq .chezmoi.os "darwin" -}}brew upgrade --cask --greedy{{ end }}
  brew cleanup --prune=all
  brew autoremove
  $doctor && brew doctor

  local mins=$((SECONDS / 60)) secs=$((SECONDS % 60))
  print "\nDone in ${mins}m ${secs}s."
  command -v osascript >/dev/null 2>&1 &&
    osascript -e "display notification \"Homebrew maintenance done (${mins}m ${secs}s)\" with title \"brewm\"" 2>/dev/null
}

# Keep activation last so later PATH changes cannot override mise-managed tools.
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"
typeset -U path PATH
