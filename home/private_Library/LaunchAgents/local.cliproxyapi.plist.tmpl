<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.cliproxyapi</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/opt/cliproxyapi/bin/cliproxyapi</string>
		<string>-config</string>
		<string>{{ .chezmoi.homeDir }}/.config/cliproxyapi/config.yaml</string>
	</array>
	<key>WorkingDirectory</key>
	<string>{{ .chezmoi.homeDir }}/.config/cliproxyapi</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>{{ .chezmoi.homeDir }}</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/.local/state/cliproxyapi/cliproxyapi.log</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/.local/state/cliproxyapi/cliproxyapi.log</string>
</dict>
</plist>
