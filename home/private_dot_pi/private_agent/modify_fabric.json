#!/usr/bin/env bash
# Owns one thing in pi-fabric's settings and leaves the rest to Fabric, which
# writes the same file from /fabric settings:
#
# - executor is a Pi-owned MCP server. Fabric's full-code mode hides Pi's
#   native codemode and tool_search, and by default Fabric only reaches the
#   servers mcporter knows (~/.mcporter, ~/.codex/config.toml), not mcp.json.
#   Listing the server here makes it callable as mcp.executor.* inside
#   fabric_exec, with Pi's connection and auth.
#
# chezmoi passes the current file on stdin and writes back stdout. Without jq
# the file passes through unchanged and the next apply sets the key.
set -euo pipefail

current="$(cat)"
[ -n "$current" ] || current='{}'

if ! command -v jq >/dev/null 2>&1; then
  printf '%s' "$current"
  exit 0
fi

printf '%s' "$current" | jq '
  .mcp.nativeServers = (((.mcp.nativeServers // []) + ["executor"]) | unique)
'
