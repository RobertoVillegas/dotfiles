#!/usr/bin/env bash
# Render chezmoi templates as every kind of machine would, and shellcheck the
# shell scripts among them. Arguments are paths under home/; without any, every
# file there is checked.
#
# A template can only fail on a machine whose data reaches its broken branch, so
# each file is rendered once per profile below. A script is shellchecked as each
# of those machines would run it.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

profiles=(
  '{"chezmoi":{"os":"darwin"},"profile":"dev","role":"workstation","editor":"both","personal":true}'
  '{"chezmoi":{"os":"darwin"},"profile":"dev","role":"devbox","container":"orbstack"}'
  '{"chezmoi":{"os":"linux"},"profile":"dev","role":"devbox","gpu":"nvidia","container":"docker-engine"}'
  '{"chezmoi":{"os":"linux"},"profile":"dev","role":"devbox","target":"wsl","gpu":"nvidia"}'
  '{"chezmoi":{"os":"linux"},"profile":"base","role":"workstation"}'
)

if [ "$#" -eq 0 ]; then
  files=()
  while IFS= read -r file; do files+=("$file"); done < <(git ls-files home)
else
  files=("$@")
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

failures=0
for file in "${files[@]}"; do
  [ -f "$file" ] || continue
  is_template=""
  case "$file" in
    *.tmpl | home/.chezmoiignore | home/.chezmoiremove) is_template=1 ;;
  esac
  is_shell=""
  case "$file" in
    home/.chezmoiscripts/* | */executable_*) head -n 1 "$file" | grep -qE '^#!.*\b(ba)?sh\b' && is_shell=1 ;;
  esac
  [ -n "$is_template" ] || [ -n "$is_shell" ] || continue

  for data in "${profiles[@]}"; do
    rendered="$work/rendered"
    if [ -n "$is_template" ]; then
      if ! chezmoi execute-template --override-data "$data" <"$file" >"$rendered" 2>"$work/err"; then
        printf '%s: template fails for %s\n' "$file" "$data" >&2
        sed 's/^/  /' "$work/err" >&2
        failures=$((failures + 1))
        continue
      fi
    else
      cp "$file" "$rendered"
    fi
    # A template that renders to nothing is skipped on that machine.
    if [ -n "$is_shell" ] && [ -s "$rendered" ] && ! shellcheck -S warning "$rendered" >"$work/err" 2>&1; then
      printf '%s: shellcheck fails for %s\n' "$file" "$data" >&2
      sed "s|$rendered|$file|; s/^/  /" "$work/err" >&2
      failures=$((failures + 1))
    fi
    # Plain scripts render the same everywhere; one pass is enough.
    [ -n "$is_template" ] || break
  done
done

if [ "$failures" -gt 0 ]; then
  printf '%d check(s) failed.\n' "$failures" >&2
  exit 1
fi
